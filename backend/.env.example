# 复制为 .env 后按本机实际情况修改
SECRET_KEY=dev-secret-change-me
DEBUG=1

# 数据库引擎：sqlite（默认，本地开发零配置）或 postgres（生产）
DB_ENGINE=sqlite
# 仅 DB_ENGINE=postgres 时生效
DB_NAME=yisao
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# 微信小程序（不配置时 /auth/wechat-login 返回 400）
WECHAT_APPID=
WECHAT_SECRET=

# 微信开放平台「网站应用」网页 OAuth（与小程序配置独立；回调地址须登记为部署域名 /web/）
WECHAT_OPEN_APPID=
WECHAT_OPEN_SECRET=
