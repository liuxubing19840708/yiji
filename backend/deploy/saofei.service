# systemd 单元 —— 复制到 /etc/systemd/system/saofei.service
[Unit]
Description=Saofei backend (gunicorn)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=notify
User=saofei
Group=saofei
WorkingDirectory=/opt/saofei/backend
EnvironmentFile=/opt/saofei/backend/.env
ExecStart=/opt/saofei/backend/.venv/bin/gunicorn -c deploy/gunicorn.conf.py config.wsgi
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3
# 基础加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/saofei/backend/media /opt/saofei/backend/logs /opt/saofei/backend/static

[Install]
WantedBy=multi-user.target
