# 扫菲生产环境变量模板 —— 复制为 .env 后填写；.env 永不入库
# 生成 SECRET_KEY:  python -c "import secrets;print(secrets.token_urlsafe(50))"

# ---- Django 核心 ----
SECRET_KEY=
DEBUG=0
ALLOWED_HOSTS=api.yourdomain.com
# CORS 白名单（生产缺省关闭全放行）；小程序直连不走 CORS，此项留给管理后台等 Web 端
CORS_ALLOW_ALL=0
CORS_ALLOWED_ORIGINS=https://admin.yourdomain.com

# ---- 数据库（PostgreSQL 15 本机）----
DB_ENGINE=postgres
DB_NAME=saofei
DB_USER=saofei
DB_PASSWORD=          # openssl rand -base64 24 生成
DB_HOST=127.0.0.1
DB_PORT=5432

# ---- TLS 安全旗标（nginx 已做 80→443 跳转，故 SSL_REDIRECT 缺省关）----
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=31536000
SECURE_COOKIES=1

# ---- 微信 ----
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_WXACODE_ENV=release
# 开放平台网站应用（Web OAuth）；开放平台后台授权回调域须与部署域名一致
WECHAT_OPEN_APPID=
WECHAT_OPEN_SECRET=

# ---- 备份异地上传（可选，backup.sh 钩子）----
# OSS_UPLOAD=1
# OSS_BUCKET=oss://saofei-backup
