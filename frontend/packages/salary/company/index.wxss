/* 薪酬管理（管理员） */
.loading { padding: 40rpx 0; text-align: center; }

/* 首页：期间两项汇总 + 单一结算入口 */
.overview-card { display: flex; }
.overview-item { flex: 1; text-align: center; }
.overview-item + .overview-item { border-left: 2rpx solid var(--color-border); }
.overview-label { color: var(--color-text-3); font-size: 26rpx; }
.overview-num { margin-top: 12rpx; font-size: 40rpx; font-weight: 600; }
.unset { color: var(--color-primary); }
.settled { color: var(--color-success); }
.center-entry { margin-top: 20rpx; }
.center-head { margin: 20rpx 0; }
.center-back, .section-back { color: var(--color-primary); font-size: 28rpx; }
.center-head-space { width: 140rpx; }
.center-actions { padding: 8rpx 24rpx; }
.center-action { margin: 16rpx 0; }
.section-back { margin: 8rpx 0 20rpx; }

/* 工资结算确认 */
.settle-total { margin: 16rpx 0; }
.settle-grid { margin-bottom: 16rpx; }
.settle-grid-item { padding: 12rpx 0; border-bottom: 1rpx solid var(--color-border); }
.settle-actions { gap: 16rpx; }
.settle-btn { flex: 1; }
.picker-box, .input { background: var(--color-bg); border-radius: var(--radius); padding: 18rpx 22rpx; margin: 12rpx 0 18rpx; box-sizing: border-box; }
.adjust-grid { display: grid; grid-template-columns: 1fr; gap: 12rpx; }

/* 结算记录 */
.card-list { margin-top: 16rpx; }
.st-card { margin-bottom: 16rpx; }
.caret { margin-left: 16rpx; }
.detail-box { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid var(--color-border); }
.d-row { padding: 8rpx 0; }
.revoke-btn { margin-top: 16rpx; color: var(--color-danger); }
.load-more { text-align: center; padding: 20rpx 0; }

/* 申请记录 */
.seg { background: var(--color-bg); border-radius: 12rpx; padding: 6rpx; margin-bottom: 16rpx; }
.seg-item { flex: 1; text-align: center; padding: 12rpx 0; border-radius: 10rpx; color: var(--color-text-2); font-size: 26rpx; }
.seg-item.on { background: var(--color-primary); color: var(--color-card); }
.ap-card { margin-bottom: 16rpx; }
.ap-actions { gap: 16rpx; margin-top: 16rpx; }
.ap-btn { flex: 1; padding-left: 0; padding-right: 0; }

/* 员工工资列表：详情进入员工薪酬页 */
.emp-head { margin: 28rpx 0 16rpx; }
.emp-card { margin-bottom: 16rpx; }
.emp-title { font-size: 32rpx; font-weight: 600; }
.emp-wage { margin-top: 20rpx; }
.arrow { font-size: 36rpx; }

/* 薪资条 + 撤销 并排（GAP-4，2026-11-04） */
.st-actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.st-actions .revoke-btn { flex: 1; margin-top: 0; }
.st-actions .btn-plain:last-child { color: var(--color-danger); }
.st-actions .btn-plain:first-child { color: var(--color-primary, #2f6fed); }
