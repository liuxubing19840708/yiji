/* 完成汇总（三层钻取） */
.loading { padding: 40rpx 0; text-align: center; }

.head-card { margin-top: 16rpx; }
.filter-row { margin-top: 16rpx; gap: 16rpx; }
.filter-picker { flex: 1; }
.filter-btn {
  background: var(--color-bg);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: var(--color-text-2);
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 面包屑 */
.crumb-row { margin: 16rpx 4rpx 16rpx; }
.crumb { color: var(--color-primary); font-size: 26rpx; }

/* 款式卡 */
.s-card { margin-bottom: 16rpx; }
.qty-badge { background: var(--color-primary-light); color: var(--color-primary); border-radius: 999rpx; padding: 4rpx 20rpx; font-size: 24rpx; }
.s-nums { margin: 12rpx 0 8rpx; }
.s-amount { font-weight: 600; }
.s-foot { margin-top: 8rpx; }

/* 工序行 */
.p-card { margin-bottom: 16rpx; }
.p-caret { margin-left: 12rpx; }

/* 矩阵与员工表 */
.m-row { padding: 12rpx 0; border-bottom: 1rpx solid var(--color-border); }
.m-row:last-child { border-bottom: none; }
.m-color { min-width: 96rpx; }
.e-head { padding: 12rpx 0; border-bottom: 1rpx solid var(--color-border); }
.e-row { padding: 12rpx 0; border-bottom: 1rpx solid var(--color-border); }
.e-row:last-child { border-bottom: none; }
.e-col { width: 25%; }
.e-right { text-align: right; }

/* ============ 维度汇总视图（2026-10-29 合并看板「维度查看」，样式同 kanban） ============ */
.dim-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
}
.dim-tab {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-text-2);
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: var(--color-card);
  box-shadow: var(--shadow);
}
.dim-tab.on {
  background: var(--color-primary);
  color: #ffffff;
  font-weight: 600;
}
/* 维度表内子 tab 收紧下边距（外层 card 自带 padding） */
.dim-sub-tabs { margin-bottom: 16rpx; }
/* 维度表可下钻行（订单/裁床）：按压反馈 */
.dim-click:active { opacity: 0.6; }

/* 扁平聚合表：列定宽、超宽横向滑（与 kanban plan-table 同款） */
.plan-scroll { width: 100%; }
.plan-table {
  display: inline-block;
  min-width: 100%;
  border: 2rpx solid var(--color-border);
  border-radius: 12rpx;
  overflow: hidden;
}
.pt-row {
  display: flex;
  align-items: stretch;
}
.pt-cell {
  box-sizing: border-box;
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  font-size: 24rpx;
  color: var(--color-text-2);
  border-right: 2rpx solid var(--color-border);
  border-bottom: 2rpx solid var(--color-border);
  word-break: break-all;
  overflow: hidden;
  display: flex;
  align-items: center;
}
.pt-row:last-child .pt-cell { border-bottom: none; }
.pt-cell:last-child { border-right: none; }
/* 表头：浅底 + 加粗 */
.pt-head .pt-cell {
  background: var(--color-bg);
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-2);
  white-space: nowrap;
}
