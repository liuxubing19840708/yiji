<!-- 与我相关的变更：员工视角审计流（scope=mine），样式复用日志管理页 -->
<view class="page">
  <!-- 加载态（首屏） -->
  <view wx:if="{{loading && !items.length}}" class="card">
    <view class="text-3 chg-center">加载中…</view>
  </view>

  <!-- 失败态 -->
  <view wx:elif="{{error}}" class="card" bindtap="onRetry">
    <empty-state text="加载失败" sub="网络异常，点击重试" />
  </view>

  <!-- 空态 -->
  <view wx:elif="{{!items.length}}" class="card">
    <empty-state text="暂无与我相关的变更" sub="涉及你的登记、价格与撤销记录都会在这里留痕" />
  </view>

  <!-- 列表 -->
  <block wx:else>
    <view class="card chg-item" wx:for="{{items}}" wx:key="id">
      <view class="row">
        <view class="badge">{{item.type_display || '其他'}}</view>
        <view class="spacer"></view>
        <view class="text-3">{{item.timeText}}</view>
      </view>
      <view class="chg-message">{{item.message}}</view>
      <view class="text-3">操作人：{{item.operator_name || '—'}}</view>
    </view>

    <view class="text-3 chg-center chg-more">
      {{loading ? '加载中…' : (hasMore ? '上拉加载更多' : '没有更多了')}}
    </view>
  </block>
</view>
