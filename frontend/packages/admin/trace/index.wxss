/* 质量追溯入口页（样式从简，沿用全局 page/card/btn 体系） */
.page { padding: 24rpx; }

.scan-card { display: flex; align-items: center; padding: 28rpx; margin-bottom: 24rpx; }
.scan-icon { font-size: 48rpx; margin-right: 24rpx; }
.scan-main { flex: 1; }
.scan-title { font-size: 32rpx; font-weight: 600; }
.scan-sub { margin-top: 6rpx; }

.tabs { display: flex; margin-bottom: 24rpx; }
.tab { flex: 1; text-align: center; padding: 18rpx 0; border-bottom: 4rpx solid transparent; color: #86909C; }
.tab.active { color: #FF7A00; border-bottom-color: #FF7A00; font-weight: 600; }

.form .input { border: 2rpx solid #E5E6EB; border-radius: 12rpx; padding: 16rpx 20rpx; margin-bottom: 20rpx; }
.form .btn { margin-top: 8rpx; }

.item { margin-bottom: 20rpx; }
.item-title { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.row { display: flex; justify-content: space-between; align-items: center; }
.lot-chip { display: inline-block; background: #FFF3E0; color: #FF7A00; border-radius: 8rpx; padding: 2rpx 12rpx; margin: 4rpx 8rpx 0 0; }
.state { text-align: center; padding: 60rpx 0; }
