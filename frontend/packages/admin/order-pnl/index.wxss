/* 订单损益页样式（取 app.wxss 变量；类名自足不依赖宿主页） */

.summary {
  display: flex;
}

.summary .stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 600;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.chip {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: var(--color-card, #ffffff);
  border: 2rpx solid var(--color-border);
  font-size: 24rpx;
  color: var(--color-text-2);
}

.chip-on {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #ffffff;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  background: var(--color-card, #ffffff);
  border: 2rpx solid var(--color-border);
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
}

.btn-sm {
  font-size: 24rpx;
  padding: 10rpx 22rpx;
  white-space: nowrap;
}

.pnl-row {
  background: var(--color-card, #ffffff);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
}

.sub-line {
  margin: 6rpx 0 12rpx;
}

.grid {
  display: flex;
  margin-top: 8rpx;
}

.g-cell {
  flex: 1;
  text-align: center;
}

.g-num {
  font-size: 28rpx;
  font-weight: 600;
}

.g-num-sm {
  font-size: 26rpx;
}

.g-label {
  margin-top: 2rpx;
}

.pos {
  color: var(--color-success, #18a058);
}

.neg {
  color: var(--color-danger, #d03050);
}

.badge-yellow {
  background: #fff7e6;
  color: #d48806;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.state {
  text-align: center;
  padding: 60rpx 0;
}

.state-btn {
  margin-top: 20rpx;
}
