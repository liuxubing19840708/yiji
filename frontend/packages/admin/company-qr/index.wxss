/* 公司二维码页（规格 §3.1）：橙色全屏，颜色取自 app.wxss 主题变量 */
.qr-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-primary);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
}

/* ---- 公司名 + 城市卡片 ---- */
.co-card {
  width: 100%;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  box-shadow: var(--shadow);
  text-align: center;
}

.co-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text);
}

.co-city {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--color-text-3);
}

/* ---- 二维码 ---- */
.qr-box {
  margin-top: 48rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  box-shadow: var(--shadow);
}

.qr-canvas {
  width: 440rpx;
  height: 440rpx;
}

/* ---- 企业编号 ---- */
.no-label {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 4rpx;
}

.no-value {
  margin-top: 8rpx;
  font-size: 64rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 8rpx;
}

.slogan {
  margin-top: 32rpx;
  font-size: 30rpx;
  color: #ffffff;
}

/* ---- 分享 / 保存 ---- */
.share-btn {
  margin-top: 64rpx;
  width: 100%;
  background: var(--color-card);
  color: var(--color-primary);
}

.save-btn {
  margin-top: 24rpx;
  padding: 16rpx 0;
  width: 100%;
  text-align: center;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* ---- 加载 / 失败态 ---- */
.state {
  margin-top: 40vh;
  text-align: center;
}

.state-text {
  color: #ffffff;
  font-size: 28rpx;
}

.retry-btn {
  margin-top: 24rpx;
  width: 240rpx;
  background: var(--color-card);
  color: var(--color-primary);
  font-size: 28rpx;
}
