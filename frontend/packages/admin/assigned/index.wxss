/* ---- 员工选择 ---- */
.sec {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.sec-head {
  margin-bottom: 16rpx;
}

.emp-scroll {
  white-space: nowrap;
  width: 100%;
}

.emp-chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin: 0 16rpx 8rpx 0;
  border-radius: 999rpx;
  border: 2rpx solid var(--color-border);
  background: var(--color-card);
  color: var(--color-text-2);
  font-size: 26rpx;
}

.emp-chip.on {
  border-color: var(--color-primary);
  color: var(--color-primary);
  background: var(--color-primary-light);
  font-weight: 600;
}

/* ---- 搜索 ---- */
.search-bar {
  display: flex;
  align-items: center;
  background: var(--color-bg);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  margin-bottom: 16rpx;
}

.search-icon {
  color: var(--color-text-3);
  font-size: 30rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-clear {
  color: var(--color-text-3);
  padding: 0 8rpx;
  font-size: 26rpx;
}

/* ---- 工序列表 ---- */
.proc-list {
  display: flex;
  flex-wrap: wrap;
}

.proc-item {
  display: flex;
  align-items: center;
  border: 2rpx solid var(--color-border);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
  color: var(--color-text-2);
}

.proc-item.on {
  border-color: var(--color-primary);
  color: var(--color-primary);
  background: var(--color-primary-light);
}

.proc-check {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-border);
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
  margin-right: 10rpx;
  color: #ffffff;
}

.proc-item.on .proc-check {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.proc-name {
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---- 保存 ---- */
.state-tip {
  text-align: center;
  padding: 40rpx 0;
}

.save-row {
  margin-top: 8rpx;
}

.btn-save {
  min-width: 200rpx;
  margin: 0;
}

.tip {
  text-align: center;
  margin-top: 8rpx;
}
