/* 轻量仓库页（最小可用，样式从简） */
.page { padding: 24rpx; }

.tabs { display: flex; margin-bottom: 24rpx; }
.tab { flex: 1; text-align: center; padding: 18rpx 0; border-bottom: 4rpx solid transparent; color: #86909C; }
.tab.active { color: #FF7A00; border-bottom-color: #FF7A00; font-weight: 600; }

.toolbar { display: flex; justify-content: flex-end; margin-bottom: 20rpx; }
.add-btn { color: #FF7A00; font-weight: 600; padding: 8rpx 16rpx; }

.form .input { border: 2rpx solid #E5E6EB; border-radius: 12rpx; padding: 16rpx 20rpx; margin-bottom: 20rpx; }
.form .picker { color: #4E5969; }
.form .btn { margin-top: 8rpx; }
.hint { margin-top: 16rpx; text-align: center; }

.item { margin-bottom: 20rpx; }
.item-title { font-size: 30rpx; font-weight: 600; }
.row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.confirm-btn { margin-top: 16rpx; }
.badge { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 8rpx; }
.badge-gray { background: #F2F3F5; color: #86909C; }
.badge-green { background: #E8F5E9; color: #2BA471; }
.state { text-align: center; padding: 60rpx 0; }
