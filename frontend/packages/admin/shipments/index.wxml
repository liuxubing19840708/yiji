<view class="page">
  <!-- 无权限防御态（shipment.view；后端 403 兜底） -->
  <view wx:if="{{denied}}" class="state">
    <view class="text-3">暂无「出货查看」权限，请联系管理员开通</view>
  </view>

  <block wx:else>
    <view class="toolbar">
      <view class="spacer"></view>
      <view class="batch-btn" wx:if="{{canManage}}" bindtap="onOpenCreate">＋ 新建出货单</view>
    </view>

    <!-- 状态 chip（shipped/signed 预留态不进 chip） -->
    <view class="chip-bar">
      <view wx:for="{{statusChips}}" wx:key="key"
        class="chip {{statusIndex === index ? 'chip-on' : ''}}"
        data-index="{{index}}" bindtap="onStatusChip">{{item.label}}</view>
    </view>

    <!-- 客户筛选 + 关键词 -->
    <view class="card filter-card">
      <view class="row">
        <picker mode="selector" range="{{customerNames}}" value="{{customerIndex}}" bindchange="onCustomerChange">
          <view class="filter-chip">{{customerNames[customerIndex]}} ▾</view>
        </picker>
        <input class="search grow" placeholder="出货单号/客户/订单号/物流单号"
          value="{{keyword}}" bindinput="onKeyword" bindconfirm="onSearch"
          confirm-type="search" />
        <view class="search-btn" bindtap="onSearch">查询</view>
      </view>
    </view>

    <view wx:if="{{loading && !rows.length}}" class="state text-3">加载中…</view>
    <view wx:elif="{{error && !rows.length}}" class="state">
      <view class="text-3">加载失败，请重试</view>
      <button class="btn btn-ghost state-btn" bindtap="reload">重新加载</button>
    </view>
    <empty-state wx:elif="{{loaded && !rows.length}}" text="暂无出货单"
      sub="点「新建出货单」录入明细，审核后自动生成应收" />

    <view class="card shp-card" wx:for="{{rows}}" wx:key="id"
      data-id="{{item.id}}" bindtap="onOpenDetail">
      <view class="row">
        <view class="item-main">
          <view class="item-title">{{item.shipmentNo}}</view>
          <view class="text-3">{{item.customerName}}{{item.orderNo ? ' · ' + item.orderNo : ''}}</view>
        </view>
        <view class="badge {{item.statusClass}}">{{item.statusText}}</view>
      </view>
      <view class="row shp-meta">
        <view class="text-3">{{item.totalQty}} 件 · {{item.boxes}} 箱</view>
        <view class="spacer"></view>
        <view class="text-3" wx:if="{{item.shipDate}}">{{item.shipDate}}</view>
      </view>
      <view class="text-3 sub-line" wx:if="{{item.logisticsNo}}">物流：{{item.logisticsNo}}</view>
      <view class="text-3 sub-line" wx:if="{{item.remark}}">备注：{{item.remark}}</view>
    </view>

    <view wx:if="{{loading && rows.length}}" class="text-3 loading-more">加载中…</view>
    <view wx:elif="{{loaded && !hasMore && rows.length}}" class="text-3 loading-more">没有更多了</view>
  </block>
</view>
