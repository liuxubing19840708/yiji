/* 报价列表页样式（颜色/圆角/阴影取自 app.wxss 变量） */

.chip-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.chip {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: var(--color-card, #ffffff);
  border: 2rpx solid var(--color-border);
  font-size: 24rpx;
  color: var(--color-text-2);
}

.chip-on {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #ffffff;
}

.filter-card {
  margin-bottom: 20rpx;
}

.grow {
  flex: 1;
}

.search {
  background: var(--color-bg);
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
}

.search-btn {
  background: var(--color-primary);
  color: #ffffff;
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.toolbar {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.batch-btn {
  background: var(--color-primary);
  color: #ffffff;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
}

.q-card {
  margin-bottom: 16rpx;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-title {
  font-size: 30rpx;
  font-weight: 600;
}

.badge {
  margin-left: 12rpx;
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.badge-blue {
  background: #E8F3FF;
  color: var(--color-info, #1989FA);
}

.cols {
  margin-top: 16rpx;
}

.col {
  flex: 1;
  text-align: center;
  min-width: 0;
}

.col-num {
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sub-row {
  margin-top: 12rpx;
}

.warn-text {
  color: var(--color-warning, #FF8800);
}

.loading-more {
  text-align: center;
  padding: 16rpx 0;
}

.state {
  text-align: center;
  padding: 100rpx 0;
}

.state-btn {
  margin-top: 24rpx;
  width: 240rpx;
  font-size: 28rpx;
  padding: 14rpx 0;
}
