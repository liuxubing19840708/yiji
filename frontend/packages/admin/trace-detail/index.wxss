/* 追溯详情页（三种视角共用，样式从简） */
.page { padding: 24rpx; }
.card { margin-bottom: 20rpx; }
.sec-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.kv { display: flex; padding: 8rpx 0; font-size: 28rpx; }
.kv .k { width: 180rpx; color: #86909C; flex-shrink: 0; }
.hl { color: #FF7A00; font-weight: 600; }

.tl-row { display: flex; padding: 12rpx 0; }
.tl-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #FF7A00; margin: 12rpx 20rpx 0 0; flex-shrink: 0; }
.tl-main { flex: 1; font-size: 28rpx; }
.state { text-align: center; padding: 60rpx 0; }
