.tip-card {
  padding: 20rpx 24rpx;
}

.setting-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.setting-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.setting-row:first-child {
  padding-top: 0;
}

.setting-main {
  flex: 1;
  margin-right: 24rpx;
}

.setting-label {
  font-size: 30rpx;
  color: var(--color-text);
}

.setting-value {
  color: var(--color-text-2);
  font-size: 28rpx;
}

.arrow {
  margin-left: 8rpx;
  color: var(--color-text-3);
  font-size: 32rpx;
}

.row-disabled {
  opacity: 0.45;
}
