/* 生产看板浅色主题（2026-10-17 与全站色系统一：只用 app.wxss 设计令牌，不写死颜色） */

.page {
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* 顶部标题 + 实时钟 */
.board-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 8rpx 8rpx 24rpx;
}

.board-title {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: 2rpx;
}

.board-sub {
  display: flex;
  align-items: baseline;
}

.board-date {
  font-size: 24rpx;
  color: var(--color-text-3);
  margin-right: 20rpx;
}

.board-clock {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-primary);
  font-variant-numeric: tabular-nums;
}

/* 时间范围 tab：自绘 chips（今日/昨日/本月/上月），选中驱动所有统计块 */
.range-tabs {
  display: flex;
  margin-bottom: 24rpx;
  padding: 8rpx;
  background: var(--color-card);
  border-radius: 999rpx;
  box-shadow: var(--shadow);
}

.range-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-2);
  padding: 14rpx 0;
  border-radius: 999rpx;
}

.range-tab.on {
  background: var(--color-primary);
  color: #ffffff;
  font-weight: 600;
}

/* ---- 维度切换（2026-10-23）：款式/订单/裁床/部门/组/人，横向可滑 chip ---- */
.dim-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
}

.dim-tab {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-text-2);
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: var(--color-card);
  box-shadow: var(--shadow);
}

.dim-tab.on {
  background: var(--color-primary);
  color: #ffffff;
  font-weight: 600;
}

/* 维度表可下钻行（订单/裁床）：按压反馈 */
.dim-click:active {
  opacity: 0.6;
}

/* 卡片：与全站 card 同款白卡 + 阴影 */
.board-card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 24rpx;
  padding-left: 18rpx;
  border-left: 6rpx solid var(--color-primary);
  line-height: 1.3;
}

.card-empty {
  text-align: center;
  color: var(--color-text-3);
  font-size: 24rpx;
  padding: 32rpx 0;
}

/* 加载/错误态 */
.board-state {
  text-align: center;
  color: var(--color-text-2);
  padding: 160rpx 0;
  font-size: 28rpx;
}

.retry {
  margin-top: 24rpx;
  width: 240rpx;
  font-size: 26rpx;
  padding: 12rpx 0;
  background: var(--color-primary-light);
  color: var(--color-primary);
  border-radius: 999rpx;
}

.retry::after {
  border: none;
}

/* 强调色 */
.accent {
  color: var(--color-primary);
}

/* ---- 汇总数据条：七个数字（前四个随 range，后三个存量），卡头展示 ---- */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
}

.stat-item {
  flex: 1;
  min-width: 25%;
  box-sizing: border-box;
  text-align: center;
  margin-bottom: 12rpx;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--color-text);
  font-variant-numeric: tabular-nums;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
}

/* ---- 生产计划表：模板列驱动（贴近 Excel 的横向表格） ---- */

.plan-scroll {
  width: 100%;
}

/* 表格本体：列段 flex、列定宽，超宽整体横向滑 */
.plan-table {
  display: inline-block;
  min-width: 100%;
  border: 2rpx solid var(--color-border);
  border-radius: 12rpx;
  overflow: hidden;
}

/* 模板名（表头上方小字） */
.pt-meta {
  padding: 8rpx 16rpx 0;
  font-size: 22rpx;
  color: var(--color-text-3);
  text-align: right;
}

.pt-row {
  display: flex;
  align-items: stretch;
}

/* 列段：一块内某列的纵向格子序列 */
.pt-seg {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
}

/* 单元格：真实格边框画出列线（右+下），无取整缝；
   行线只画到每段最后一格为止，块边界由 .pt-block 的下边框统一画 ——
   这样合并段（单格跨多行）内部天然无横线，视觉上就是一整格 */
.pt-cell {
  box-sizing: border-box;
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  font-size: 24rpx;
  color: var(--color-text-2);
  border-right: 2rpx solid var(--color-border);
  border-bottom: 2rpx solid var(--color-border);
  word-break: break-all;
  overflow: hidden;
  display: flex;
  align-items: center;   /* 内容垂直居中（合并格同款） */
}

/* 段内最后一格去下边框（避免与块边框叠线） */
.pt-seg .pt-cell:last-child {
  border-bottom: none;
}

/* 块边界 = 块元素下边框；表末块不画（表格边框兜底） */
.pt-block {
  border-bottom: 2rpx solid var(--color-border);
}

.pt-block:last-child {
  border-bottom: none;
}

.pt-seg:last-child .pt-cell {
  border-right: none;
}

/* 单元格文本：床次「床号×数量」多行用 pre-line 逐行显示 */
.pt-cell-text {
  width: 100%;
}

.pt-cell-text.pre {
  white-space: pre-line;
  line-height: 1.4;
}

/* 对齐 */
.pt-cell.ta-right { justify-content: flex-end; font-variant-numeric: tabular-nums; }
.pt-cell.ta-center { justify-content: center; }

/* 占位单元格（todo 字段/公式求值失败） */
.pt-cell.hold {
  color: var(--color-text-3);
}

/* merge=block 合并段：单格跨多行本身就是一整格，
   水平对齐跟随列 align（ta-*），垂直居中由 .pt-cell 的 align-items 保证 */

/* 表头：浅底 + 加粗 */
.pt-head .pt-cell {
  background: var(--color-bg);
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-2);
  white-space: nowrap;
}

.pt-head-row {
  display: flex;
  align-items: stretch;
}

/* 两级表头：组头列 = 纵向 flex（组头格 + 叶子行） */
.pt-hcol {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
}

.pt-hcol .group-cell {
  justify-content: center;
  border-bottom: 2rpx solid var(--color-border);
}

.pt-hcol .leaf {
  white-space: normal;
  text-align: center;
}

/* 款块：底色按全表连续奇偶交替（奇数组铺浅底） */
.pt-block {
  display: flex;
  align-items: stretch;
}

.pt-block.pt-alt {
  background: var(--color-bg);
}

/* 日期分组小标题行（如「9月15日」） */
.pt-date .pt-date-label {
  flex: 1;
  box-sizing: border-box;
  padding: 10rpx 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text);
  background: var(--color-primary-light);
}

/* ---- 通用进度条（进度/工序共用） ---- */
.bar {
  height: 14rpx;
  border-radius: 999rpx;
  background: var(--color-bg);
  border: 2rpx solid var(--color-border);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--color-primary);
}

/* ---- 登记排行 ---- */
.rank {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.rank-no {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--color-bg);
  color: var(--color-text-3);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.rank-no.top {
  background: var(--color-primary);
  color: #ffffff;
  font-weight: 600;
}

.rank-name {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.rank-sub {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--color-text-3);
  flex: 1;
}

.rank-qty {
  font-size: 28rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

/* ---- 工序占比 ---- */
.proc {
  margin-bottom: 24rpx;
}

.proc:last-child {
  margin-bottom: 0;
}

.proc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.proc-name {
  font-size: 26rpx;
  color: var(--color-text);
}

.proc-val {
  font-size: 24rpx;
  color: var(--color-text-2);
  font-variant-numeric: tabular-nums;
}

/* 自定义时间段：起止 picker 同一行（此前无样式，picker 块级各占一行） */
.custom-range {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 8rpx;
  background: var(--color-card);
  border-radius: 999rpx;
  box-shadow: var(--shadow);
}
.custom-range picker {
  flex: 1;
}
.cr-item {
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-2);
  padding: 14rpx 0;
}
.cr-sep {
  color: var(--color-text-3);
  font-size: 24rpx;
  margin: 0 12rpx;
}

/* ---- 顶层页签：计划表 / 订单（§2.9 P1 订单页签；与 range-tabs 同观感但层级在上） ---- */
.board-tabs {
  display: flex;
  margin-bottom: 20rpx;
  padding: 8rpx;
  background: var(--color-card);
  border-radius: 999rpx;
  box-shadow: var(--shadow);
}

.board-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-2);
  padding: 16rpx 0;
  border-radius: 999rpx;
}

.board-tab.on {
  background: var(--color-primary);
  color: #ffffff;
}

/* 可下钻单元格：可点提示（↗ 角标 + 按压反馈）；data-nav 为空的普通格无此样式 */
.pt-cell.link {
  cursor: pointer;
}

.pt-cell.link .pt-cell-text::after {
  content: '↗';
  font-size: 18rpx;
  color: var(--color-text-3);
  margin-left: 6rpx;
}

.pt-cell.link:active {
  background: var(--color-primary-light);
}

/* ---- 订单页签：卡片墙（完成率环形 + 交期灯 + 落后 chip + 未挂单床次汇总） ---- */
.ord-upgrade {
  text-align: center;
  padding: 80rpx 28rpx;
}

.ord-upgrade-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.ord-upgrade-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.ord-wall {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.ord-card {
  width: 48.5%;
  box-sizing: border-box;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}

.ord-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.ord-no {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  word-break: break-all;
}

.ord-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  margin-left: 12rpx;
}

.ord-badge-producing {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.ord-badge-done {
  background: rgba(0, 180, 42, 0.12);
  color: var(--color-success);
}

.ord-badge-cancelled {
  background: var(--color-bg);
  color: var(--color-text-3);
}

.ord-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  margin-bottom: 16rpx;
}

.ord-body {
  display: flex;
  align-items: center;
}

/* 完成率环形：conic-gradient 外环 + 白圆心（样式串由 ts 拼好下发） */
.ord-ring {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ord-ring-hole {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  background: var(--color-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ord-ring-num {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text);
  font-variant-numeric: tabular-nums;
}

.ord-side {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.ord-light-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

/* 交期灯（绿=充裕 / 黄=≤7天 / 红=逾期 / 灰=未设交期） */
.lamp {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.lamp-green {
  background: var(--color-success);
}

.lamp-yellow {
  background: var(--color-warning);
}

.lamp-red {
  background: var(--color-danger);
}

.lamp-gray {
  background: var(--color-border);
}

.ord-chips {
  display: flex;
  flex-wrap: wrap;
}

.ord-chip {
  font-size: 20rpx;
  color: var(--color-text-2);
  background: var(--color-bg);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
  font-variant-numeric: tabular-nums;
}

/* 落后色码 chip（决策：完成率 <80% 且生产中 → 红底警示） */
.ord-chip-behind {
  background: rgba(245, 63, 63, 0.1);
  color: var(--color-danger);
  font-weight: 600;
}
