/* 使用帮助：角色 tab + 文档正文（只用 app.wxss 设计令牌） */
.page {
  padding: 24rpx;
  box-sizing: border-box;
}

/* 角色 tab（与看板 range-tabs 同观感） */
.help-tabs {
  display: flex;
  margin-bottom: 24rpx;
  padding: 8rpx;
  background: var(--color-card);
  border-radius: 999rpx;
  box-shadow: var(--shadow);
}

.help-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-2);
  padding: 14rpx 0;
  border-radius: 999rpx;
}

.help-tab.on {
  background: var(--color-primary);
  color: #ffffff;
  font-weight: 600;
}

.help-card {
  padding: 32rpx 28rpx;
}

.help-role-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 24rpx;
}

.help-sec-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
  margin: 24rpx 0 12rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid var(--color-primary);
  line-height: 1.3;
}

.help-line {
  font-size: 26rpx;
  color: var(--color-text-2);
  line-height: 1.7;
  margin-bottom: 10rpx;
}

.help-foot {
  text-align: center;
  margin-top: 32rpx;
}
