/* 打印管理页样式（颜色/圆角/阴影取自 app.wxss 变量） */

.printer-info {
  margin-top: 16rpx;
}

.printer-name {
  font-size: 34rpx;
  font-weight: 600;
}

.printer-tip {
  margin-top: 16rpx;
}

.btn-row {
  margin-top: 24rpx;
}

.btn-flex {
  flex: 1;
  margin: 0 12rpx;
}

.btn-flex:first-child {
  margin-left: 0;
}

.btn-flex:last-child {
  margin-right: 0;
}

.device-row,
.tpl-row,
.queue-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.setting-main {
  flex: 1;
  margin-right: 24rpx;
}

.setting-label {
  font-size: 30rpx;
  color: var(--color-text);
}

.setting-value {
  color: var(--color-text-2);
  font-size: 28rpx;
}

.arrow {
  margin-left: 8rpx;
  color: var(--color-text-3);
  font-size: 32rpx;
}

.tpl-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.device-row:first-of-type,
.queue-row:first-of-type {
  margin-top: 8rpx;
}

.queue-row:last-of-type {
  border-bottom: none;
  padding-bottom: 0;
}

.rssi {
  margin-left: 12rpx;
  width: 110rpx;
  text-align: right;
}

.rescan-tip {
  padding-top: 20rpx;
}

.btn-mini {
  margin-left: 16rpx;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  line-height: 1.6;
  min-height: 0;
}

.cp-foot {
  text-align: center;
  padding: 24rpx 0;
}

/* ---- 菲票版式自定义面板 ---- */

.sub-row {
  padding: 20rpx 0;
}

.sub-row .setting-label {
  font-size: 28rpx;
  color: var(--color-text-2);
}

.field-title {
  margin-top: 20rpx;
}

.field-chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.chip {
  padding: 10rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--color-text-2);
  background: var(--color-bg, #f5f5f5);
  border: 2rpx solid transparent;
}

.chip-on {
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-color: var(--color-primary);
  font-weight: 500;
}

/* ---- 上下微调步进器 ---- */

.stepper {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.step-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--color-bg, #f5f5f5);
  color: var(--color-text);
  font-size: 34rpx;
}

.step-val {
  min-width: 88rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text);
}

/* ---- 打印历史：搜索 + 补打 + 补打过徽标（M3） ---- */

.history-search {
  padding: 16rpx 0;
}

.history-input {
  background: var(--color-bg, #f5f5f5);
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.history-title-row {
  justify-content: flex-start;
}

.h-reprint-badge {
  margin-left: 12rpx;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  line-height: 1.6;
  flex-shrink: 0;
}
