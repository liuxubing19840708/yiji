/* 质检管理（GAP-1，2026-11-04） */
.top-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 0;
}
.tabs {
  display: flex;
  flex: 1;
  gap: 8rpx;
}
.tab {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--color-text-2, #4e5969);
  background: rgba(0, 0, 0, 0.05);
}
.tab.on {
  color: #fff;
  background: var(--color-primary, #2f6fed);
}
.export-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-primary, #2f6fed);
  background: var(--color-primary-light, rgba(47, 111, 237, 0.1));
}
.export-btn.disabled {
  opacity: 0.5;
}

.open-form-btn {
  background: var(--color-primary, #2f6fed);
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

/* 登记表单 */
.form-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.form-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.form-input {
  flex: 1;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--color-border, #e5e6eb);
  border-radius: 12rpx;
  font-size: 28rpx;
}
.form-input.reason {
  margin-bottom: 16rpx;
}
.form-picker {
  flex: 1.4;
}
.lookup-btn {
  flex-shrink: 0;
  padding: 0 28rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--color-primary, #2f6fed);
  background: var(--color-primary-light, rgba(47, 111, 237, 0.1));
}
.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--color-border, #e5e6eb);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}
.picker-field.placeholder {
  color: var(--color-text-3, #86909c);
}
.caret {
  color: var(--color-text-3, #86909c);
}
.form-actions {
  display: flex;
  gap: 16rpx;
}
.btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 12rpx;
}
.btn.primary {
  background: var(--color-primary, #2f6fed);
  color: #fff;
}
.btn.primary.disabled {
  opacity: 0.6;
}
.btn.ghost {
  background: rgba(0, 0, 0, 0.05);
  color: var(--color-text-2, #4e5969);
}

.state-tip {
  padding: 60rpx 0;
  text-align: center;
  color: var(--color-text-3, #86909c);
  font-size: 26rpx;
}

/* 记录卡片 */
.q-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.q-bed {
  font-size: 30rpx;
  font-weight: 600;
}
.q-status {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}
.q-status.st-rework {
  color: #d46b08;
  background: rgba(212, 107, 8, 0.1);
}
.q-status.st-received {
  color: var(--color-primary, #2f6fed);
  background: var(--color-primary-light, rgba(47, 111, 237, 0.1));
}
.q-status.st-done {
  color: var(--color-success, #00b42a);
  background: rgba(0, 180, 42, 0.1);
}
.q-info {
  font-size: 26rpx;
  margin-bottom: 6rpx;
}
.q-qty {
  font-size: 26rpx;
  margin-bottom: 6rpx;
}
.q-qty .bad {
  color: var(--color-danger, #f53f3f);
  font-weight: 600;
}
.q-reason {
  font-size: 26rpx;
  color: var(--color-text-2, #4e5969);
  margin-bottom: 6rpx;
}
.q-meta {
  font-size: 22rpx;
}
.dim {
  color: var(--color-text-3, #86909c);
}
.num {
  font-weight: 600;
}
.q-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border, #f0f0f0);
}
.act {
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}
.act.primary {
  color: #fff;
  background: var(--color-primary, #2f6fed);
}
.act.danger {
  color: var(--color-danger, #f53f3f);
  background: rgba(245, 63, 63, 0.08);
}
