/* 按扎卡片视图（竞品对齐借鉴#1）：扎卡 + 工序价目行 + 登记明细行 */
.head-card {
  margin-bottom: 12rpx;
}

.b-card {
  margin-bottom: 16rpx;
}

.bundle-no {
  font-size: 30rpx;
  font-weight: 600;
  margin-right: 12rpx;
}

.b-sub {
  margin-top: 6rpx;
}

.caret {
  margin-left: 12rpx;
}

/* 工序行 */
.proc-list {
  margin-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 12rpx;
}

.proc-empty {
  padding: 8rpx 0;
}

.proc-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.dot-done {
  background: #34b96f;
}

.dot-part {
  background: #e6a23c;
}

.dot-none {
  background: #d5d5d5;
}

.proc-name {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.proc-price {
  font-size: 26rpx;
  color: #e0563a;
}

.proc-count {
  margin-left: 12rpx;
}

/* 登记明细行 */
.rec-block {
  margin: 4rpx 0 8rpx 28rpx;
  padding-left: 16rpx;
  border-left: 3rpx solid #f0f0f0;
}

.rec-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.rec-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.rec-act {
  background: #3a7afe;
}

.rec-locked {
  background: #d5d5d5;
}

.rec-name {
  font-size: 26rpx;
  margin-right: 10rpx;
}

.rec-tip {
  padding: 8rpx 0 4rpx;
}

/* 改数弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  width: 620rpx;
  padding: 32rpx;
}

.mod-title {
  margin: 8rpx 0 16rpx;
}

.mod-field {
  margin: 16rpx 0;
  align-items: center;
}

.mod-label {
  width: 180rpx;
  font-size: 28rpx;
}

.mod-input {
  flex: 1;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
}

.mod-actions {
  margin-top: 24rpx;
  justify-content: flex-end;
  gap: 16rpx;
}

.mod-btn {
  min-width: 160rpx;
}
