/* 报价编辑页样式（取 app.wxss 变量） */

.state {
  text-align: center;
  padding: 100rpx 0;
}

.card {
  margin-bottom: 16rpx;
}

.form-head {
  margin-bottom: 16rpx;
}

.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.form-label {
  width: 160rpx;
  font-size: 26rpx;
  color: var(--color-text-2);
  flex-shrink: 0;
}

.req {
  color: var(--color-danger);
}

.grow {
  flex: 1;
  min-width: 0;
}

.picker-box {
  background: var(--color-bg);
  border-radius: var(--radius);
  padding: 16rpx 24rpx;
  font-size: 26rpx;
}

.input {
  background: var(--color-bg);
  border-radius: var(--radius);
  padding: 16rpx 24rpx;
  font-size: 26rpx;
}

.input.tiny {
  width: 160rpx;
  padding: 10rpx 16rpx;
  margin: 0 8rpx;
}

.hint {
  margin-top: 8rpx;
  line-height: 1.6;
}

.mini-btn {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--color-border);
  font-size: 24rpx;
  color: var(--color-text-2);
  margin-left: 12rpx;
}

.mini-primary {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #ffffff;
}

.mat-row {
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--color-border);
}

.mat-row:last-of-type {
  border-bottom: none;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.mat-name {
  font-size: 26rpx;
  font-weight: 600;
}

.del-btn {
  flex-shrink: 0;
  color: var(--color-danger);
}

.inline-inputs {
  margin-top: 12rpx;
}

.rate-warn {
  margin: 0 0 16rpx 160rpx;
  padding: 10rpx 20rpx;
  border-radius: var(--radius);
  background: rgba(255, 136, 0, 0.1);
  color: var(--color-warning, #FF8800);
  font-size: 24rpx;
  line-height: 1.6;
}

.save-btn {
  width: 100%;
  margin: 24rpx 0 calc(24rpx + env(safe-area-inset-bottom));
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: var(--color-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-head {
  margin-bottom: 20rpx;
}
