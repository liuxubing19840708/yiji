/* 出货单详情/编辑页样式（取 app.wxss 变量） */

.state {
  padding: 120rpx 40rpx;
  text-align: center;
}

.state-btn {
  margin-top: 24rpx;
}

.picker-box {
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  margin-top: 16rpx;
}

.pick-note {
  margin-top: 8rpx;
}

.input {
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  margin-top: 16rpx;
}

.row-2col {
  gap: 16rpx;
}

.col-input {
  flex: 1;
  min-width: 0;
}

.item-card {
  margin-top: 20rpx;
}

.h2 {
  font-size: 32rpx;
  font-weight: 600;
}

.h3-line {
  font-size: 28rpx;
  font-weight: 600;
}

.ref-line {
  margin-top: 10rpx;
}

.link-btn {
  color: var(--color-info);
  font-size: 26rpx;
}

.add-link {
  margin: 16rpx 0 8rpx;
}

.btn-bar {
  display: flex;
  gap: 20rpx;
  margin: 30rpx 0 60rpx;
}

.btn-bar .btn {
  flex: 1;
}

.audit-btn {
  background: var(--color-success, #07c160);
}

.void-btn {
  color: var(--color-danger);
}

.save-sm {
  margin-top: 20rpx;
}

.info-line {
  margin-top: 10rpx;
}

.th-row {
  margin-top: 16rpx;
  padding-bottom: 8rpx;
  border-bottom: 2rpx solid var(--color-border);
}

.tr-row {
  padding: 10rpx 0;
  border-bottom: 2rpx solid var(--color-bg);
}

.th-col {
  flex: 1;
  text-align: center;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
}

.box-card {
  margin-top: 16rpx;
  padding: 16rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
}

.op-btn {
  font-size: 24rpx;
  color: var(--color-info);
  padding: 6rpx 20rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 999rpx;
}

.op-danger {
  color: var(--color-danger);
}

.print-row {
  margin-top: 16rpx;
  gap: 20rpx;
}

.print-btn {
  flex: 1;
}

.log-row {
  margin-top: 16rpx;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.reprint-badge {
  margin-left: 10rpx;
  font-size: 20rpx;
}
