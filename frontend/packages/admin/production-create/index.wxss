/* 新建床次 + 编菲页样式（颜色/圆角取自 app.wxss 变量） */

.sheet-head {
  margin-bottom: 16rpx;
}

.field {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid var(--color-border);
  padding: 24rpx 4rpx;
}

.field-top {
  align-items: flex-start;
}

.label {
  width: 180rpx;
  color: var(--color-text-2);
  font-size: 28rpx;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 30rpx;
}

.input.placeholder {
  color: var(--color-text-3);
}

.textarea {
  flex: 1;
  min-height: 120rpx;
  font-size: 28rpx;
}

.tip {
  margin-top: 20rpx;
  text-align: center;
}

/* ---- 阶段一：款式选择面板 ---- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: var(--color-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.search-row {
  margin-bottom: 16rpx;
}

.search {
  flex: 1;
  background: var(--color-bg);
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  font-size: 28rpx;
}

.search-btn {
  margin-left: 16rpx;
  color: var(--color-primary);
  font-size: 28rpx;
}

.style-list {
  max-height: 68vh;
  min-height: 30vh;
}

.style-item {
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--color-border);
}

.style-item:last-child {
  border-bottom: none;
}

.s-no {
  font-size: 30rpx;
  font-weight: 600;
}

.state-tip {
  text-align: center;
  padding: 60rpx 0;
}

/* ================= 阶段二：编菲矩阵 ================= */

/* ---- 颜色/尺码 chips ---- */
.chip-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.chip-label {
  width: 84rpx;
  color: var(--color-text-2);
  font-size: 26rpx;
  flex-shrink: 0;
}

.chip {
  display: flex;
  align-items: center;
  background: var(--color-bg);
  border: 2rpx solid var(--color-border);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  font-size: 26rpx;
}

.chip-add {
  color: var(--color-primary);
  border-style: dashed;
  border-color: var(--color-primary);
  background: var(--color-card);
}

.chip-x {
  margin-left: 8rpx;
  color: var(--color-text-3);
  padding: 0 4rpx;
}

/* ---- 视图页签 ---- */
.tabs {
  display: flex;
  gap: 8rpx;
  margin: 8rpx 0 20rpx;
  flex-wrap: wrap;
}

.tab {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--color-card);
  color: var(--color-text-2);
  font-size: 26rpx;
  border: 2rpx solid var(--color-border);
}

.tab.on {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
}

/* ---- 矩阵 ---- */
.mtx-cap {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  padding: 0 4rpx;
}

.mtx-scroll {
  width: 100%;
  margin-top: 12rpx;
}

.mtx {
  display: inline-block;
  min-width: 100%;
}

.mtx-row {
  display: flex;
  align-items: stretch;
}

.mtx-row + .mtx-row {
  border-top: 2rpx solid var(--color-border);
}

.mtx-label {
  width: 112rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--color-text-2);
  background: var(--color-bg);
  padding: 16rpx 0;
}

.mtx-cell {
  width: 128rpx;
  flex-shrink: 0;
  text-align: center;
  padding: 16rpx 4rpx;
  box-sizing: border-box;
}

.mtx-cell.tappable {
  border-left: 2rpx dashed var(--color-border);
}

.mtx-cell.filled {
  background: var(--color-primary-light);
}

.mtx-cell.filled .mtx-main {
  color: var(--color-primary);
  font-weight: 600;
}

.mtx-main {
  font-size: 30rpx;
  color: var(--color-text-3);
}

.mtx-sub {
  font-size: 20rpx;
  color: var(--color-text-3);
}

.mtx-total {
  width: 96rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--color-primary);
}

.mtx-head .mtx-label,
.mtx-head .mtx-cell,
.mtx-head .mtx-total {
  background: var(--color-bg);
  color: var(--color-text-2);
  font-size: 24rpx;
}
/* 行头/列头=横向/纵向复制入口（数字快捷填写，不改表头） */
.mtx-label.cpy,
.mtx-cell.cpy {
  color: var(--color-info);
  font-weight: 600;
}

.mtx-foot {
  margin-top: 16rpx;
}

.multi-head {
  margin-bottom: 8rpx;
}

.mini-input {
  min-width: 160rpx;
  text-align: right;
  color: var(--color-primary);
  font-size: 28rpx;
  padding: 8rpx 0 8rpx 16rpx;
}

.mini-btn {
  margin-left: 16rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

/* ---- 扎号视图 ---- */
.bundle-head {
  margin-top: 20rpx;
}

.bundle-list {
  max-height: 60vh;
  overflow-y: auto;
}

.bundle-item {
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--color-border);
}

.bundle-item:last-child {
  border-bottom: none;
}

.bundle-item.tail .bundle-no {
  color: var(--color-primary);
}

.bundle-no {
  width: 72rpx;
  font-size: 30rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.bundle-info {
  margin-left: 8rpx;
  font-size: 26rpx;
}

.bundle-qty {
  font-size: 28rpx;
}

.bundle-note {
  margin-top: 16rpx;
}

/* ---- 底部操作 ---- */
.save-bar {
  margin-top: 24rpx;
  gap: 20rpx;
}

.btn-clear {
  flex: 1;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  background: var(--color-card);
}

.save-btn {
  flex: 2;
}

.save-bar .btn {
  width: auto;
}

/* ---- 颜色点选面板（厂内常用色 + 内置常用色） ---- */
.color-panel {
  margin: 12rpx 0 4rpx 88rpx;
  padding: 16rpx 20rpx;
  background: var(--color-bg);
  border-radius: var(--radius);
}
.cp-title {
  margin-bottom: 12rpx;
}
.cp-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.cp-chip {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: var(--color-card);
  border: 2rpx solid var(--color-border);
  font-size: 26rpx;
  color: var(--color-text);
}
.cp-chip.cp-added {
  opacity: 0.45;
  border-style: dashed;
}
.cp-chip.cp-custom {
  color: var(--color-primary);
  border-color: var(--color-primary);
}

/* 表单页面料历史点选（点击直接填充面料输入框） */
.fh-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}
.fh-chip {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: var(--color-bg);
  border: 2rpx solid var(--color-border);
  font-size: 24rpx;
  color: var(--color-text-2);
}
.fh-chip.fh-on {
  color: var(--color-primary);
  border-color: var(--color-primary);
}

/* ================= 向导步骤条 ================= */
.wiz-card {
  padding: 24rpx 16rpx;
}

.wiz-steps {
  display: flex;
  align-items: center;
}

.wiz-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.wiz-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  background: var(--color-bg);
  color: var(--color-text-3);
  border: 2rpx solid var(--color-border);
}

.wiz-step.on .wiz-dot {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #ffffff;
  font-weight: 600;
}

.wiz-name {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-3);
  white-space: nowrap;
}

.wiz-step.on .wiz-name {
  color: var(--color-primary);
  font-weight: 600;
}

.wiz-line {
  flex: 1;
  height: 4rpx;
  background: var(--color-border);
  margin: 0 12rpx 36rpx;
  border-radius: 999rpx;
}

.wiz-line.on {
  background: var(--color-primary);
}

/* ================= 第 1 步：挂单 ================= */
.order-brief {
  margin-top: 16rpx;
}

.order-no {
  font-size: 30rpx;
  font-weight: 600;
}

.order-main {
  flex: 1;
  min-width: 0;
}

.mini-btn.ghost {
  background: var(--color-card);
  color: var(--color-text-2);
  border: 2rpx solid var(--color-border);
}

.step-tip {
  margin-top: 12rpx;
}

/* ================= 导航按钮条（第 1~3 步） ================= */
.nav-bar {
  margin-top: 24rpx;
  gap: 20rpx;
}

.nav-bar .btn {
  width: auto;
}

.nav-btn {
  flex: 1;
}

.nav-main {
  flex: 2;
}

/* ================= 第 3 步：工序工价 ================= */
.proc-head {
  margin-top: 16rpx;
  padding-bottom: 8rpx;
  border-bottom: 2rpx solid var(--color-border);
}

.proc-row {
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--color-border);
}

.proc-row:last-child {
  border-bottom: none;
}

.proc-name {
  font-size: 28rpx;
}

.proc-price {
  flex-shrink: 0;
}

.proc-input {
  width: 220rpx;
  flex: none;
  text-align: right;
  background: var(--color-bg);
  border-radius: var(--radius);
  padding: 10rpx 20rpx;
  font-size: 28rpx;
}

.zero-warn {
  color: var(--color-danger);
}

/* ================= 第 4 步：实时尾扎预览 ================= */
.tail-summary {
  margin-top: 12rpx;
  padding: 12rpx 20rpx;
  background: var(--color-primary-light);
  border-radius: var(--radius);
  color: var(--color-primary);
  font-weight: 600;
}

.tail-preview {
  margin-top: 12rpx;
  padding: 12rpx 20rpx;
  background: var(--color-primary-light);
  border-radius: var(--radius);
  color: var(--color-primary);
  font-weight: 600;
  text-align: center;
}

/* ================= 第 5 步：成功页 ================= */
.done-card {
  text-align: center;
  padding: 64rpx 32rpx;
}

.done-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: #E8FFEA;
  color: var(--color-success);
  font-size: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.done-title {
  margin-bottom: 8rpx;
}

.done-btn {
  margin-top: 28rpx;
}

.done-hint {
  margin-top: 16rpx;
}

/* ================= 底部操作（第 4 步三按钮） ================= */
.back-btn {
  flex: 1;
  color: var(--color-text-2);
}

.clear-btn {
  flex: 1;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  background: var(--color-card);
}
