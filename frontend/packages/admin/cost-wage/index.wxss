/* 工资对账单页样式（颜色/圆角/阴影一律取自 app.wxss 变量） */

.note-card {
  font-size: 24rpx;
  color: var(--color-warning, #FF8800);
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.total {
  flex: 1;
  text-align: center;
}

.total-num {
  font-size: 34rpx;
  font-weight: 600;
}

.range-line {
  margin-top: 14rpx;
  text-align: center;
}

.wrow {
  margin-bottom: 16rpx;
}

.wrow-main {
  flex: 1;
  min-width: 0;
}

.wrow-title {
  font-size: 28rpx;
  font-weight: 600;
}

.src {
  margin-top: 6rpx;
  line-height: 1.5;
}

.wrow-nums {
  flex-shrink: 0;
  text-align: right;
  margin-left: 16rpx;
}

.amt {
  font-size: 30rpx;
  font-weight: 600;
}

.diff {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.notes-card {
  line-height: 1.7;
}

.note-line {
  margin-top: 8rpx;
}

.state {
  text-align: center;
  padding: 100rpx 0;
}

.state-btn {
  margin-top: 24rpx;
  width: 240rpx;
  font-size: 28rpx;
  padding: 14rpx 0;
}
