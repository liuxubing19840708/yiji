.master-page { padding-top: 20rpx; }
.tab-scroll { width: calc(100% + 48rpx); margin: 0 -24rpx 24rpx; white-space: nowrap; }
.master-tabs { display: inline-flex; gap: 12rpx; padding: 4rpx 24rpx 12rpx; }
.master-tab { flex-shrink: 0; padding: 14rpx 28rpx; border-radius: 999rpx; background: var(--color-card); color: var(--color-text-2); font-size: 26rpx; box-shadow: var(--shadow); }
.master-tab.on { background: var(--color-primary); color: var(--color-card); }
.master-tools { display: flex; align-items: center; gap: 16rpx; }
.master-search { flex: 1; min-width: 0; padding: 16rpx 24rpx; border-radius: 999rpx; background: var(--color-card); box-shadow: var(--shadow); font-size: 26rpx; }
.create-btn { flex-shrink: 0; width: auto; min-width: 170rpx; margin: 0; padding: 14rpx 22rpx; font-size: 25rpx; }
.filter-select { margin-top: 20rpx; padding: 18rpx 22rpx; border-radius: var(--radius); background: var(--color-card); color: var(--color-text-2); font-size: 26rpx; }
.master-card { padding: 24rpx; }
.card-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; }
.item-title { color: var(--color-text); font-size: 30rpx; font-weight: 600; }
.price { color: var(--color-primary); font-size: 30rpx; font-weight: 600; }
.meta { margin-top: 12rpx; color: var(--color-text-3); font-size: 24rpx; line-height: 1.6; }
.row-actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 24rpx; margin-top: 20rpx; padding-top: 18rpx; border-top: 2rpx solid var(--color-border); color: var(--color-primary); font-size: 25rpx; }
.danger, .text-danger { color: var(--color-danger); }
.primary { color: var(--color-primary); }
.state-tip { padding: 64rpx 20rpx; text-align: center; color: var(--color-text-3); }
.retry { width: 220rpx; margin: 20rpx auto 0; }
.load-more { padding: 28rpx; text-align: center; color: var(--color-text-3); font-size: 25rpx; }
.mask { position: fixed; inset: 0; z-index: 100; display: flex; align-items: flex-end; background: rgba(0,0,0,.45); }
.sheet { box-sizing: border-box; width: 100%; padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: var(--radius-lg) var(--radius-lg) 0 0; background: var(--color-card); }
.sheet-head { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.sheet-title { font-size: 32rpx; font-weight: 600; }
.head-action { display: inline-block; padding: 12rpx 18rpx; color: var(--color-text-2); font-size: 26rpx; }
.sheet-body { max-height: 72vh; }
.form-row { display: flex; align-items: center; gap: 20rpx; min-height: 84rpx; padding: 16rpx 4rpx; border-bottom: 2rpx solid var(--color-border); }
.form-row > text { flex-shrink: 0; width: 160rpx; color: var(--color-text-2); font-size: 26rpx; }
.form-row > input, .form-row > view { flex: 1; min-width: 0; font-size: 28rpx; }
.form-row > textarea { flex: 1; min-height: 120rpx; font-size: 28rpx; }
.form-row.top { align-items: flex-start; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin-top: 28rpx; font-size: 26rpx; }
.section-title { display: block; margin: 26rpx 0 12rpx; color: var(--color-text); font-size: 28rpx; font-weight: 600; }
.section-head .section-title { margin: 0; }
.media-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.media-cell, .media-add { position: relative; box-sizing: border-box; width: 136rpx; height: 136rpx; border-radius: var(--radius); overflow: visible; }
.media-cell image { width: 100%; height: 100%; border-radius: var(--radius); }
.media-cell text { position: absolute; top: -12rpx; right: -12rpx; width: 36rpx; height: 36rpx; border-radius: 50%; background: var(--color-danger); color: #fff; text-align: center; line-height: 36rpx; }
.media-add { display: grid; place-items: center; border: 2rpx dashed var(--color-border); color: var(--color-text-3); font-size: 42rpx; }
.craft-video { width: 100%; height: 300rpx; }
.line-editor { margin-top: 20rpx; padding: 0 18rpx 18rpx; border-radius: var(--radius); background: var(--color-bg); }
.remove-line { display: block; padding-top: 18rpx; text-align: right; font-size: 25rpx; }
