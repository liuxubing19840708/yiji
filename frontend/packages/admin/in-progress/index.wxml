<!-- 我的登记：本人今日登记与撤销 -->
<view class="page">

  <!-- 加载错误提示 -->
  <block wx:if="{{loadError}}">
    <view class="state-tip text-danger">数据加载失败</view>
    <button class="btn btn-plain retry-btn" bindtap="onRetry">重试</button>
  </block>

  <!-- 本人今日登记 -->
  <view class="card">
    <view class="h2">我的今日登记</view>

    <view wx:if="{{loading}}" class="state-tip">加载中…</view>

    <empty-state wx:elif="{{!loadError && !records.length}}" text="今日暂无登记记录" sub="去底部「扫菲」开始今天的活儿" />

    <view wx:else class="rec-list">
      <view wx:for="{{records}}" wx:key="id" class="rec-item">
        <view class="row">
          <view class="rec-style num">{{item.style_no || item.bed_no || '-'}}</view>
          <view class="spacer"></view>
          <view class="badge badge-gray">{{item.process_name || '-'}}</view>
        </view>
        <view class="row rec-line2">
          <view class="text-3">
            {{item.bed_no || '-'}} · 扎{{item.bundle_no || '-'}} · {{item.color}}{{item.size ? ' / ' + item.size : ''}}
          </view>
          <view class="spacer"></view>
          <view class="rec-qty num">{{item.qty}} 件</view>
        </view>
        <view class="row rec-line3">
          <view class="text-3">{{item.timeText}}</view>
          <view class="spacer"></view>
          <view
            wx:if="{{item.canRevoke}}"
            class="revoke-btn {{revokingId === item.id ? 'disabled' : ''}}"
            data-id="{{item.id}}"
            bindtap="onRevoke"
          >撤销</view>
        </view>
      </view>
    </view>
  </view>

</view>
