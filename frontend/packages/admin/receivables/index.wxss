/* 应收列表页样式（取 app.wxss 变量） */

.toolbar {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.link-btn {
  color: var(--color-info);
  font-size: 26rpx;
}

.sort-btn {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--color-border);
  font-size: 24rpx;
  color: var(--color-text-2);
  margin-right: 16rpx;
}

.batch-btn {
  background: var(--color-primary);
  color: #ffffff;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
}

.chip-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.chip {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: var(--color-card, #ffffff);
  border: 2rpx solid var(--color-border);
  font-size: 24rpx;
  color: var(--color-text-2);
}

.chip-on {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #ffffff;
}

.filter-card {
  margin-bottom: 20rpx;
}

.filter-chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--color-bg);
  font-size: 24rpx;
  color: var(--color-text-2);
  flex-shrink: 0;
  margin-right: 16rpx;
}

.grow {
  flex: 1;
  min-width: 0;
}

.search {
  background: var(--color-bg);
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
}

.search-btn {
  background: var(--color-primary);
  color: #ffffff;
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.rec-card {
  margin-bottom: 16rpx;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-title {
  font-size: 30rpx;
  font-weight: 600;
}

.badge {
  margin-left: 12rpx;
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.badge-blue {
  background: #E8F3FF;
  color: var(--color-info, #1989FA);
}

.cols {
  margin-top: 16rpx;
}

.col {
  flex: 1;
  text-align: center;
  min-width: 0;
}

.col-num {
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sub-line {
  margin-top: 12rpx;
}

.loading-more {
  text-align: center;
  padding: 16rpx 0;
}

.state {
  text-align: center;
  padding: 100rpx 0;
}

.state-btn {
  margin-top: 24rpx;
  width: 240rpx;
  font-size: 28rpx;
  padding: 14rpx 0;
}

/* ---- 新建应收弹层 ---- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: var(--color-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-head {
  margin-bottom: 16rpx;
}

.sheet-sub {
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.picker-box {
  background: var(--color-bg);
  border-radius: var(--radius);
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.input {
  background: var(--color-bg);
  border-radius: var(--radius);
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
