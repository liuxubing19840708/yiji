/* 客户管理页样式（颜色/圆角/阴影一律取自 app.wxss 变量） */

.tabs {
  display: flex;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  margin-bottom: 24rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  color: var(--color-text-2);
  font-size: 30rpx;
  position: relative;
}

.tab.active {
  color: var(--color-primary);
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 8rpx;
  width: 48rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
}

.toolbar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.search {
  flex: 1;
  background: var(--color-card);
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  box-shadow: var(--shadow);
}

.add-btn {
  margin-left: 16rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 26rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-card);
  border-radius: var(--radius);
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
}

.item {
  margin-bottom: 20rpx;
}

.item-main {
  flex: 1;
}

.item-title {
  font-size: 30rpx;
  font-weight: 500;
}

.item-sub {
  margin-top: 12rpx;
}

.arrow {
  margin-left: 16rpx;
  font-size: 36rpx;
}

.state {
  text-align: center;
  padding: 120rpx 0;
}

.state-btn {
  margin-top: 24rpx;
  width: 240rpx;
  font-size: 28rpx;
  padding: 14rpx 0;
}

.load-more {
  text-align: center;
  padding: 24rpx 0;
}

/* ---- 编辑弹层 ---- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: var(--color-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-head {
  margin-bottom: 16rpx;
}

.field {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid var(--color-border);
  padding: 22rpx 4rpx;
}

.label {
  width: 160rpx;
  color: var(--color-text-2);
  font-size: 28rpx;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 30rpx;
}

.sheet-save {
  margin-top: 32rpx;
}

.sheet-delete {
  margin-top: 20rpx;
  color: var(--color-danger);
}
