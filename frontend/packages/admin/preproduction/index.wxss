.page { padding-bottom: 60rpx; }
.state { padding: 140rpx 0; text-align: center; }
.retry { width: 240rpx; margin: 24rpx auto 0; font-size: 26rpx; }
.summary { margin-bottom: 20rpx; }
.summary-main { min-width: 0; flex: 1; }
.summary .h1 { font-size: 36rpx; }
.step-tabs { position: sticky; top: 0; z-index: 5; display: grid; grid-template-columns: repeat(4, 1fr); gap: 8rpx; margin: 0 0 20rpx; padding: 10rpx; background: var(--color-bg); border-radius: 16rpx; }
.step-tab { padding: 14rpx 4rpx; text-align: center; color: var(--color-text-2); border-radius: 12rpx; font-size: 23rpx; line-height: 1.3; }
.step-tab text { display: inline-flex; align-items: center; justify-content: center; width: 30rpx; height: 30rpx; margin-right: 5rpx; border: 2rpx solid var(--color-border); border-radius: 50%; font-size: 20rpx; }
.step-tab.active { background: var(--color-primary); color: #fff; font-weight: 600; }
.step-tab.active text { border-color: rgba(255,255,255,.6); }
.section-card { padding-top: 26rpx; }
.section-head { margin-bottom: 22rpx; }
.section-tip { margin-top: 6rpx; color: var(--color-text-3); font-size: 23rpx; }
.missing { margin-top: 18rpx; padding: 16rpx 18rpx; background: var(--color-primary-light); border-radius: var(--radius); color: var(--color-text-2); }
.missing-title { color: var(--color-primary); font-weight: 600; margin-bottom: 6rpx; }
.missing-item { font-size: 25rpx; margin-top: 4rpx; }
.ready { margin-top: 18rpx; color: var(--color-success); }
.form-section { margin: 0 -24rpx; padding: 24rpx; border-top: 2rpx solid var(--color-border); }
.form-title { color: var(--color-text); font-size: 28rpx; font-weight: 600; }
.form-title-row { margin-bottom: 14rpx; }
.field { margin: 18rpx 0; }
.compact-field { margin-top: 14rpx; }
.label { color: var(--color-text-2); font-size: 25rpx; margin-bottom: 8rpx; }
.input, .picker { box-sizing: border-box; width: 100%; padding: 18rpx; background: var(--color-bg); border-radius: 12rpx; }
.readonly-value { padding: 18rpx; color: var(--color-text-2); background: var(--color-bg); border-radius: 12rpx; }
.textarea { box-sizing: border-box; width: 100%; height: 150rpx; padding: 18rpx; margin: 12rpx 0 0; background: var(--color-bg); border-radius: 12rpx; }
.textarea.short { height: 110rpx; }
.subhead { margin: 24rpx 0 12rpx; font-weight: 600; color: var(--color-text-2); }
.text-btn { display: inline-block; width: auto; margin: 0; padding: 6rpx 0 6rpx 20rpx; background: transparent; color: var(--color-info); font-size: 24rpx; line-height: 1.4; }
.text-btn::after { border: none; }
.small-btn { width: auto; margin: 14rpx 0 0; padding: 12rpx 26rpx; font-size: 25rpx; }
.save-btn { margin-top: 24rpx; }
.version-tip { padding: 14rpx; background: var(--color-primary-light); color: var(--color-primary); border-radius: 12rpx; font-size: 24rpx; }
.template-bar { margin-bottom: 10rpx; }
.template-picker { display: inline-block; padding: 12rpx 18rpx; color: var(--color-info); background: var(--color-primary-light); border-radius: 10rpx; font-size: 24rpx; }
.measure-hint { margin: 10rpx 0 14rpx; font-size: 22rpx; }
.measure-card { margin: 12rpx 0; padding: 16rpx; background: var(--color-bg); border-radius: 14rpx; }
.measure-card-head { margin-bottom: 12rpx; color: var(--color-text-2); font-size: 24rpx; font-weight: 600; }
.measure-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; }
.select-cell { padding: 12rpx 14rpx; background: #fff; border: 2rpx solid var(--color-border); border-radius: 10rpx; font-size: 26rpx; }
.select-cell text { display: block; margin-bottom: 4rpx; color: var(--color-text-3); font-size: 21rpx; }
.select-empty view { color: var(--color-text-3); }
.remove { flex: 0 0 auto; text-align: center; color: var(--color-danger); font-size: 24rpx; }
.attachment-block { margin: 14rpx 0 0; padding: 14rpx 16rpx; border: 2rpx solid var(--color-border); border-radius: 12rpx; }
.file-row { display: flex; align-items: center; margin-top: 10rpx; padding-top: 10rpx; border-top: 2rpx solid var(--color-border); }
.file-row .remove { padding-left: 16rpx; font-size: 34rpx; }
.file-name { flex: 1; min-width: 0; color: var(--color-info); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.current-result, .confirm-box { margin-bottom: 20rpx; padding: 18rpx; background: var(--color-bg); border-radius: 12rpx; }
.ok-text { color: var(--color-success); font-weight: 600; }
.bad-text { color: var(--color-danger); font-weight: 600; }
.empty { padding: 20rpx 0; text-align: center; }
.history { margin-top: 26rpx; padding-top: 4rpx; border-top: 2rpx solid var(--color-border); }
.history-item, .issue-item { padding: 18rpx 0; border-bottom: 2rpx solid var(--color-border); }
.history-item:last-child, .issue-item:last-child { border-bottom: none; }
.history-line { margin: 10rpx 0; }
.attachment-link { display: inline-block; margin: 8rpx 16rpx 0 0; color: var(--color-info); font-size: 24rpx; }
.issue-item { margin-top: 12rpx; }
.issue-title { flex: 1; min-width: 0; margin-right: 12rpx; }
.resolution { margin: 12rpx 0; color: var(--color-text-2); }
.issue-action { margin-top: 12rpx; padding-left: 0; }
.approval-panel { margin-top: 26rpx; padding-top: 4rpx; border-top: 2rpx solid var(--color-border); }
.approval-actions { display: flex; gap: 16rpx; }
.half { flex: 1; font-size: 27rpx; }
.danger { color: var(--color-danger); }
