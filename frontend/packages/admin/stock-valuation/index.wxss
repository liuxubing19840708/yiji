/* 库存估值页样式（取 app.wxss 变量） */

.state {
  text-align: center;
  padding: 100rpx 0;
}

.state-btn {
  margin-top: 24rpx;
  width: 240rpx;
  font-size: 28rpx;
  padding: 14rpx 0;
}

.card {
  margin-bottom: 16rpx;
}

.note-card {
  padding-bottom: 20rpx;
}

.note-line {
  margin-top: 10rpx;
  line-height: 1.6;
}

.filter-card {
  margin-bottom: 20rpx;
}

.filter-row {
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--color-bg);
  font-size: 24rpx;
  color: var(--color-text-2);
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-chip.wide {
  max-width: 360rpx;
}

.search-btn {
  background: var(--color-primary);
  color: #ffffff;
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
}

.val-card {
  margin-bottom: 16rpx;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-title {
  font-size: 30rpx;
  font-weight: 600;
}

.badge {
  margin-left: 12rpx;
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.cols {
  margin-top: 16rpx;
}

.col {
  flex: 1;
  text-align: center;
  min-width: 0;
}

.col-num {
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lot-head {
  margin-top: 16rpx;
  padding: 8rpx 0;
  border-bottom: 2rpx solid var(--color-border);
}

.lot-row {
  padding: 10rpx 0;
  border-bottom: 2rpx solid var(--color-border);
}

.lot-row:last-of-type {
  border-bottom: none;
}

.lot-cell {
  flex: 1;
  font-size: 22rpx;
  text-align: center;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lot-cell:first-child {
  flex: 1.3;
  text-align: left;
}

.lot-empty {
  margin-top: 12rpx;
}

.detail-hint {
  margin-top: 12rpx;
}
