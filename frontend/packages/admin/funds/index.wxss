.tabs { white-space: nowrap; margin-bottom: 20rpx; }
.tab-row, .chip-row, .range-row, .money-row { display: flex; align-items: center; }
.tab { display: inline-block; padding: 14rpx 24rpx; color: var(--color-text-2); font-size: 26rpx; border-bottom: 4rpx solid transparent; }
.tab-on { color: var(--color-primary); border-bottom-color: var(--color-primary); font-weight: 600; }
.toolbar { display: flex; justify-content: flex-end; margin-bottom: 20rpx; }
.primary-btn, .query-btn { background: var(--color-primary); color: #fff; border-radius: 999rpx; padding: 12rpx 26rpx; font-size: 26rpx; }
.grow { flex: 1; min-width: 0; }
.record-card, .flow-card { margin-bottom: 16rpx; }
.title { font-size: 30rpx; font-weight: 600; margin-bottom: 6rpx; }
.badge { flex-shrink: 0; background: #e8f6ee; color: #16834b; border-radius: 999rpx; padding: 4rpx 14rpx; font-size: 22rpx; }
.badge-void { background: #f0f1f3; color: #777; }
.money-row { justify-content: space-between; gap: 12rpx; margin: 18rpx 0; font-size: 24rpx; flex-wrap: wrap; }
.danger { color: #d94343 !important; }
.income { color: #16834b; }
.action { margin-top: 18rpx; padding-top: 16rpx; border-top: 2rpx solid var(--color-border); text-align: right; font-size: 25rpx; }
.range-row { gap: 12rpx; flex-wrap: wrap; font-size: 24rpx; }
.range-row .picker-box { margin: 0; padding: 12rpx 16rpx; }
.chip-row { gap: 12rpx; margin: 18rpx 0; }
.chip { padding: 10rpx 24rpx; border: 2rpx solid var(--color-border); border-radius: 999rpx; font-size: 24rpx; }
.chip-on { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
.totals { display: flex; border-top: 2rpx solid var(--color-border); padding-top: 20rpx; }
.totals > view { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx; min-width: 0; }
.total-num { font-size: 28rpx; font-weight: 600; }
.flow-detail { margin-top: 8rpx; line-height: 1.5; }
.note { line-height: 1.7; padding: 12rpx 4rpx 28rpx; }
.state { text-align: center; padding: 90rpx 0; }
.state-small { text-align: center; padding: 20rpx 0; }
.mask { position: fixed; inset: 0; z-index: 100; background: rgba(0,0,0,.45); display: flex; align-items: flex-end; }
.sheet { width: 100%; max-height: 88vh; background: var(--color-card); border-radius: var(--radius-lg) var(--radius-lg) 0 0; padding: 30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.sheet-head { justify-content: space-between; margin-bottom: 20rpx; }
.form-scroll { max-height: 70vh; }
.picker-box, .input, .textarea { background: var(--color-bg); border-radius: var(--radius); padding: 18rpx 22rpx; font-size: 27rpx; margin-bottom: 18rpx; box-sizing: border-box; }
.textarea { width: 100%; height: 130rpx; }
.form-label { font-size: 24rpx; color: var(--color-text-2); margin: 0 0 8rpx 4rpx; }
.datetime-row { display: flex; gap: 12rpx; }
.datetime-row picker { flex: 1; min-width: 0; }
.datetime-row .picker-box { width: 100%; box-sizing: border-box; }
