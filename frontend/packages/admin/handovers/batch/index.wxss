.batch-page { padding-bottom: 60rpx; }
.batch-head { text-align: center; }
.batch-no { margin-top: 8rpx; font-size: 32rpx; font-weight: 600; word-break: break-all; }
.stats-row { display: flex; text-align: center; }
.stats-row > view { flex: 1; }
.stat-num { display: block; font-size: 36rpx; font-weight: 600; }
.totals { margin-top: 24rpx; padding-top: 20rpx; border-top: 2rpx solid var(--color-border); }
.handover-row { padding: 24rpx; }
.row-title { font-weight: 600; word-break: break-all; }
.badge-pending { color: var(--color-primary); background: var(--color-primary-light); }
.badge-received { color: var(--color-success); background: #E8FFEA; }
.badge-rejected, .badge-cancelled { color: var(--color-text-3); background: #F2F3F5; }
.route { margin: 10rpx 0; }
.row-bottom { margin-top: 16rpx; }
.difference { margin-left: 16rpx; font-size: 24rpx; }
.state { text-align: center; padding: 100rpx 0; }
.retry { width: 220rpx; margin-top: 24rpx; font-size: 26rpx; }
