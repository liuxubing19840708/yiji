.create-page { padding-bottom: 60rpx; }
.route-card { display: flex; align-items: center; }
.route-node { flex: 1; text-align: center; min-width: 0; }
.route-arrow { color: var(--color-primary); font-size: 40rpx; padding: 0 24rpx; }
.node-name { font-size: 32rpx; font-weight: 600; margin-top: 8rpx; }
.summary { display: flex; text-align: center; }
.summary > view { flex: 1; }
.summary-num { display: block; font-size: 36rpx; font-weight: 600; }
.target-title { font-size: 30rpx; }
.target-id { margin-top: 8rpx; }
.ticket-head, .ticket-row { display: flex; justify-content: space-between; gap: 24rpx; }
.ticket-head { border-bottom: 2rpx solid var(--color-border); margin-top: 20rpx; padding: 12rpx 0; }
.ticket-row { padding: 14rpx 0; border-bottom: 2rpx solid var(--color-border); }
.ticket-row:last-child { border-bottom: none; }
.ticket-label { flex: 1; min-width: 0; word-break: break-all; }
.field-title { margin-bottom: 16rpx; }
.remark-input { box-sizing: border-box; width: 100%; height: 160rpx; background: var(--color-bg); border-radius: var(--radius); padding: 20rpx; }
.submit-btn { margin-top: 12rpx; }
.submit-tip { text-align: center; margin-top: 20rpx; }
.state { text-align: center; padding-top: 100rpx; }
.param-tip { margin: 20rpx 0; }
.back-btn { margin-top: 20rpx; }
.success-card { text-align: center; padding: 60rpx 32rpx; }
.success-icon { width: 88rpx; height: 88rpx; line-height: 88rpx; border-radius: 50%; background: var(--color-success); color: #fff; font-size: 52rpx; margin: 0 auto 24rpx; }
.result-count { margin: 24rpx 0 36rpx; }
