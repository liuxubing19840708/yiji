.chips {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: var(--color-card);
  color: var(--color-text-2);
  font-size: 26rpx;
  box-shadow: var(--shadow);
}

.chip-on {
  background: var(--color-primary);
  color: #ffffff;
}

.log-item {
  padding: 24rpx;
}

.log-message {
  margin: 16rpx 0;
  font-size: 28rpx;
  color: var(--color-text);
  word-break: break-all;
}

.log-meta {
  flex-wrap: wrap;
}

.log-target {
  margin-left: 32rpx;
}

.log-center {
  text-align: center;
  padding: 24rpx 0;
}

.log-more {
  padding: 8rpx 0 24rpx;
}
