<view class="page">
  <date-range-bar start="{{startDate}}" end="{{endDate}}" bind:change="onRangeChange" />

  <!-- type 筛选 chips -->
  <scroll-view class="chips" scroll-x enable-flex>
    <view
      wx:for="{{chips}}"
      wx:key="key"
      class="chip {{activeType === item.key ? 'chip-on' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTypeTap"
    >{{item.label}}</view>
  </scroll-view>

  <!-- 加载态（首屏） -->
  <view wx:if="{{loading && !items.length}}" class="card">
    <view class="text-3 log-center">加载中…</view>
  </view>

  <!-- 失败态 -->
  <view wx:elif="{{error}}" class="card" bindtap="onRetry">
    <empty-state text="加载失败" sub="网络异常，点击重试" />
  </view>

  <!-- 空态 -->
  <view wx:elif="{{!items.length}}" class="card">
    <empty-state text="暂无操作记录" />
  </view>

  <!-- 列表 -->
  <block wx:else>
    <view class="card log-item" wx:for="{{items}}" wx:key="id">
      <view class="row">
        <view class="badge">{{item.type_display || '其他'}}</view>
        <view class="spacer"></view>
        <view class="text-3">{{item.timeText}}</view>
      </view>
      <view class="log-message">{{item.message}}</view>
      <view class="row log-meta">
        <view class="text-3">操作人：{{item.operator_name || '—'}}</view>
        <view wx:if="{{item.target_user_name}}" class="text-3 log-target">目标员工：{{item.target_user_name}}</view>
      </view>
    </view>

    <view class="text-3 log-center log-more">
      {{loading ? '加载中…' : (hasMore ? '上拉加载更多' : '没有更多了')}}
    </view>
  </block>
</view>
