/* 到料暂收列表页样式（取 app.wxss 变量） */

.toolbar {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.link-btn {
  color: var(--color-info);
  font-size: 26rpx;
}

.batch-btn {
  background: var(--color-primary);
  color: #ffffff;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
}

.chip-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.chip {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: var(--color-card, #ffffff);
  border: 2rpx solid var(--color-border);
  font-size: 24rpx;
  color: var(--color-text-2);
}

.chip-on {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #ffffff;
}

.filter-card {
  margin-bottom: 20rpx;
}

.search {
  font-size: 26rpx;
}

.grow {
  flex: 1;
}

.search-btn {
  color: var(--color-primary);
  font-size: 26rpx;
  padding-left: 20rpx;
}

.rec-card {
  margin-bottom: 20rpx;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
}

.rec-meta {
  margin-top: 12rpx;
}

.sub-line {
  margin-top: 8rpx;
}

.state {
  padding: 120rpx 40rpx;
  text-align: center;
}

.state-btn {
  margin-top: 24rpx;
}

.loading-more {
  text-align: center;
  padding: 20rpx 0 40rpx;
}
