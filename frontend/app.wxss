/* ============ 设计令牌（全局唯一来源，禁止在页面里写死颜色） ============ */
page {
  /* 品牌色：橙色主操作（扫码 FAB / 确认） */
  --color-primary: #FF7A00;
  --color-primary-dark: #E86D00;
  --color-primary-light: #FFF3E8;
  /* 辅助色：蓝色保存 / 绿色成功 / 红色危险 */
  --color-info: #1677FF;
  --color-success: #00B42A;
  --color-danger: #F53F3F;
  --color-warning: #F7BA1E;
  /* 文字 */
  --color-text: #1F2329;
  --color-text-2: #4E5969;
  --color-text-3: #86909C;
  /* 面板 */
  --color-bg: #F5F6F8;
  --color-card: #FFFFFF;
  --color-border: #E5E6EB;
  --radius: 16rpx;
  --radius-lg: 24rpx;
  --shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.06);

  background: var(--color-bg);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* ============ 通用布局类 ============ */
.page {
  padding: 24rpx 24rpx 200rpx; /* 底部留出 tabBar+FAB 高度 */
  box-sizing: border-box;
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  box-shadow: var(--shadow);
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  align-items: center;
}

.spacer {
  flex: 1;
}

.h1 { font-size: 40rpx; font-weight: 600; }
.h2 { font-size: 32rpx; font-weight: 600; }
.text-2 { color: var(--color-text-2); }
.text-3 { color: var(--color-text-3); font-size: 24rpx; }
.text-danger { color: var(--color-danger); }
.text-primary { color: var(--color-primary); }
.num { font-variant-numeric: tabular-nums; }

/* ============ 通用按钮 ============ */
.btn {
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  padding: 20rpx 0;
  line-height: 1.4;
}
.btn::after { border: none; }
.btn-primary {
  background: var(--color-primary);
  color: #ffffff;
}
.btn-primary.disabled { opacity: 0.5; }
.btn-info {
  background: var(--color-info);
  color: #ffffff;
}
.btn-ghost {
  background: var(--color-primary-light);
  color: var(--color-primary);
}
.btn-plain {
  background: var(--color-card);
  color: var(--color-text-2);
  border: 2rpx solid var(--color-border);
}

/* 状态徽标（审核状态章等） */
.badge {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
}
.badge-gray { background: #F2F3F5; color: var(--color-text-3); }
.badge-green { background: #E8FFEA; color: var(--color-success); }
.badge-red { background: #FFECE8; color: var(--color-danger); }
