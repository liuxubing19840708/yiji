/* AI 问报页：对话、动态报表与定时运行中心 */
page { background: #f5f6f8; height: 100%; display: flex; flex-direction: column; color: #1d2129; }
.mode-tabs { display: flex; gap: 8rpx; margin: 20rpx 24rpx 0; padding: 6rpx; border-radius: 16rpx; background: #e9ebef; flex-shrink: 0; }
.mode-tab { flex: 1; padding: 14rpx 4rpx; border-radius: 12rpx; color: #4e5969; font-size: 26rpx; text-align: center; }
.mode-tab.active { background: #fff; color: #ff7a00; font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.06); }
.chat, .page-scroll { flex: 1; box-sizing: border-box; min-height: 0; }
.chat { padding: 24rpx; }
.page-scroll { padding: 20rpx 24rpx 0; }
.row { margin-bottom: 28rpx; display: flex; flex-direction: column; }
.row-user { align-items: flex-end; }
.row-ai { align-items: flex-start; }
.bubble-user { max-width: 70%; background: var(--color-primary, #ff7a00); color: #fff; padding: 18rpx 26rpx; border-radius: 20rpx 4rpx 20rpx 20rpx; font-size: 28rpx; line-height: 1.5; word-break: break-all; }
.card { max-width: 94%; background: #fff; border-radius: 20rpx 20rpx 20rpx 4rpx; padding: 24rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.04); box-sizing: border-box; }
.card-text { font-size: 28rpx; line-height: 1.6; }
.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; }
.card-summary { font-size: 26rpx; color: #4e5969; line-height: 1.6; margin-bottom: 16rpx; }
.card-note { margin-top: 14rpx; font-size: 22rpx; color: #86909c; line-height: 1.6; }
.table-scroll { width: 100%; max-width: 100%; }
.card-table { display: inline-block; min-width: 100%; border: 2rpx solid #e5e6eb; border-radius: 12rpx; overflow: hidden; }
.tr { display: flex; min-width: 100%; border-bottom: 2rpx solid #f2f3f5; }
.tr:last-child { border-bottom: none; }
.tr-head { background: #f7f8fa; }
.td { flex: 1 0 160rpx; min-width: 160rpx; padding: 14rpx 16rpx; box-sizing: border-box; font-size: 24rpx; word-break: break-all; }
.tr-head .td { color: #86909c; font-weight: 600; white-space: nowrap; }
.result-table .td { flex-basis: 190rpx; min-width: 190rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.chip { padding: 12rpx 24rpx; background: #fff3e8; color: var(--color-primary, #ff7a00); border-radius: 999rpx; font-size: 24rpx; }
.time { font-size: 20rpx; color: #c9cdd4; margin-top: 8rpx; }
.chat-bottom-pad { height: 24rpx; }
.input-bar { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom) + 110rpx); background: #fff; border-top: 2rpx solid #e5e6eb; flex-shrink: 0; }
.input { flex: 1; background: #f2f3f5; border-radius: 999rpx; padding: 16rpx 28rpx; font-size: 28rpx; }
.send { background: var(--color-primary, #ff7a00); color: #fff; font-size: 26rpx; border-radius: 999rpx; padding: 0 32rpx; line-height: 68rpx; }
.send-disabled { opacity: .5; }
.mic { width: 68rpx; height: 68rpx; border-radius: 50%; background: #f2f3f5; display: flex; align-items: center; justify-content: center; font-size: 22rpx; flex-shrink: 0; }
.mic-on { background: #fff3e8; color: #ff7a00; }

.section { margin-bottom: 20rpx; padding: 24rpx; border-radius: 18rpx; background: #fff; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.035); }
.designer-head, .section-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.section-title { margin-bottom: 8rpx; font-size: 32rpx; font-weight: 600; }
.section-subtitle { margin-bottom: 16rpx; font-size: 28rpx; font-weight: 600; }
.muted, .field-help { color: #86909c; font-size: 23rpx; line-height: 1.55; }
.field-label { margin: 18rpx 0 10rpx; color: #4e5969; font-size: 25rpx; }
.section>.field-label:first-child { margin-top: 0; }
.field-help { margin-top: 10rpx; }
.picker-value, .text-input { min-height: 72rpx; padding: 18rpx 20rpx; box-sizing: border-box; border: 2rpx solid #e5e6eb; border-radius: 12rpx; background: #fff; font-size: 26rpx; line-height: 34rpx; }
.picker-value { margin-bottom: 8rpx; }
.picker-arrow { float: right; color: #86909c; }
.form-row { display: flex; gap: 16rpx; }
.form-item { flex: 1; min-width: 0; }
.inline-form { display: flex; align-items: center; gap: 12rpx; }
.inline-form .text-input { flex: 1; }
.option-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.option { padding: 14rpx 22rpx; border: 2rpx solid #e5e6eb; border-radius: 999rpx; color: #4e5969; background: #fff; font-size: 25rpx; }
.option.selected { border-color: #ff7a00; background: #fff3e8; color: #d96500; }
.range-presets { display: flex; flex-wrap: wrap; gap: 10rpx; }
button { margin: 0; }
button::after { border: none; }
.plain-btn, .secondary-btn, .primary-btn { display: inline-flex; align-items: center; justify-content: center; border-radius: 12rpx; font-size: 25rpx; line-height: 1.4; }
.plain-btn { padding: 12rpx 18rpx; background: #f5f6f8; color: #4e5969; }
.secondary-btn { padding: 15rpx 24rpx; background: #fff3e8; color: #d96500; }
.primary-btn { padding: 17rpx 30rpx; background: #ff7a00; color: #fff; }
button[disabled] { opacity: .48; }
.switch-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 22rpx; font-size: 26rpx; }
.safe-note { padding: 12rpx 14rpx; border-radius: 10rpx; background: #f7f8fa; }
.action-bar { position: sticky; bottom: 12rpx; z-index: 2; display: flex; gap: 14rpx; padding: 16rpx; border-radius: 16rpx; background: rgba(255,255,255,.97); box-shadow: 0 4rpx 20rpx rgba(0,0,0,.12); }
.action-bar button { flex: 1; }
.export-help { margin: 14rpx 4rpx 24rpx; }
.full-btn { width: 100%; margin-top: 24rpx; }
.error { margin: 16rpx 0; padding: 16rpx 20rpx; border-radius: 12rpx; background: #fff0ed; color: #b5412d; font-size: 25rpx; line-height: 1.55; }
.error-text { margin-top: 8rpx; color: #b5412d; font-size: 23rpx; line-height: 1.5; }
.link { color: #d96500; font-size: 24rpx; white-space: nowrap; }
.scope-item { color: #86909c; font-size: 22rpx; line-height: 1.6; }
.bottom-space { height: calc(150rpx + env(safe-area-inset-bottom)); }

/* 单指标图表：文字始终保留完整数值，负值由符号和虚线共同标识 */
.chart-box { margin: 22rpx 0; padding: 18rpx; border: 2rpx solid #f0f1f3; border-radius: 14rpx; background: #fafafa; }
.chart-title { margin-bottom: 20rpx; font-size: 26rpx; font-weight: 600; }
.chart-title text { display: block; margin-top: 6rpx; color: #86909c; font-size: 20rpx; font-weight: 400; }
.bar-row { display: flex; align-items: center; gap: 12rpx; min-height: 58rpx; }
.bar-label { width: 150rpx; overflow: hidden; color: #4e5969; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.bar-track { flex: 1; height: 20rpx; border-radius: 0 8rpx 8rpx 0; background: #eceef1; }
.bar-fill { height: 20rpx; border-radius: 0 8rpx 8rpx 0; background: #ff7a00; }
.bar-fill.bar-negative { background: repeating-linear-gradient(135deg, #ff7a00, #ff7a00 6rpx, #ffc896 6rpx, #ffc896 12rpx); }
.bar-value { width: 150rpx; color: #1d2129; font-size: 21rpx; text-align: right; }
.line-chart { position: relative; width: 600rpx; height: 220rpx; margin: 8rpx 0 12rpx; }
.line-grid { position: absolute; left: 0; right: 0; border-top: 2rpx solid #e5e6eb; }
.grid-top { top: 30rpx; }.grid-mid { top: 110rpx; }.grid-bottom { top: 190rpx; }
.line-segment { position: absolute; z-index: 1; height: 4rpx; border-radius: 4rpx; background: #ff7a00; transform-origin: 0 50%; }
.line-point { position: absolute; z-index: 2; width: 36rpx; height: 36rpx; margin: -18rpx 0 0 -18rpx; display: flex; align-items: center; justify-content: center; }
.point-dot { width: 14rpx; height: 14rpx; border: 4rpx solid #fafafa; border-radius: 50%; background: #ff7a00; box-sizing: border-box; }
.line-labels { display: flex; justify-content: space-between; width: 600rpx; color: #86909c; font-size: 20rpx; }

.task-row, .schedule-card, .run-card { padding: 20rpx 0; border-top: 2rpx solid #f0f1f3; }
.task-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; font-size: 26rpx; }
.schedule-card:first-of-type { border-top: none; }
.schedule-title { font-size: 27rpx; font-weight: 600; word-break: break-all; }
.row-actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.danger-btn { color: #b5412d; }
.status { flex-shrink: 0; padding: 5rpx 12rpx; border-radius: 999rpx; background: #f0f0f0; color: #4e5969; font-size: 21rpx; }
.status-success { background: #e9f7ef; color: #19734a; }
.status-failed { background: #fff0ed; color: #b5412d; }
.retry-btn { margin-top: 14rpx; }

/* 录音浮层 */
.voice-mask { position: fixed; inset: 0; background: rgba(0,0,0,.45); display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 999; }
.voice-panel { min-width: 420rpx; max-width: 78%; background: #fff; border-radius: 24rpx; padding: 40rpx 36rpx; display: flex; flex-direction: column; align-items: center; box-shadow: 0 12rpx 40rpx rgba(0,0,0,.2); }
.voice-wave { display: flex; align-items: flex-end; gap: 10rpx; height: 56rpx; margin-bottom: 20rpx; }
.wv { width: 8rpx; border-radius: 4rpx; background: #ff7a00; animation: voice-jump .8s ease-in-out infinite; }
.wv1 { height: 24rpx; }.wv2 { height: 44rpx; animation-delay: .15s; }.wv3 { height: 56rpx; animation-delay: .3s; }.wv4 { height: 40rpx; animation-delay: .45s; }.wv5 { height: 28rpx; animation-delay: .6s; }
@keyframes voice-jump { 0%,100% { transform: scaleY(.4); } 50% { transform: scaleY(1); } }
.voice-text { min-height: 44rpx; font-size: 30rpx; line-height: 1.5; text-align: center; word-break: break-all; }
.voice-tip { margin-top: 16rpx; color: #86909c; font-size: 22rpx; }
