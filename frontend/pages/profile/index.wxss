.profile-head {
  display: flex;
  align-items: center;
}

.pf-avatar,
.pf-avatar-img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.pf-avatar {
  background: var(--color-primary-light);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 600;
}

.pf-info {
  margin-left: 24rpx;
  flex: 1;
}

.pf-admin-badge {
  margin-left: 16rpx;
}

.pf-phone {
  margin-top: 4rpx;
}

.pf-company {
  margin-top: 4rpx;
  font-size: 26rpx;
}

.pf-post {
  color: var(--color-text-2);
}

.pf-menu {
  padding: 8rpx 24rpx;
}

.pf-menu-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.pf-menu-item:last-child {
  border-bottom: none;
}

.pf-menu-main {
  flex: 1;
}

.pf-menu-label {
  font-size: 30rpx;
  color: var(--color-text);
}

.pf-danger .pf-menu-label {
  color: var(--color-danger);
}

.pf-arrow {
  color: var(--color-text-3);
  font-size: 32rpx;
}

.pf-foot {
  text-align: center;
  padding: 24rpx 0 0;
}

.pf-version {
  text-align: center;
  padding: 8rpx 0 24rpx;
}
