.grid {
  display: flex;
  flex-wrap: wrap;
  background: var(--color-card, #fff);
  border-radius: var(--radius-lg, 24rpx);
  box-shadow: var(--shadow);
  padding: 16rpx 0;
}

.cell {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.cell:active {
  opacity: 0.6;
}

.cell-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  background: var(--color-primary-light, #FFF3E8);
  color: var(--color-primary, #FF7A00);
}

/* 每个模块专属底色（与 pages/index 的 emoji 图标一一对应；未知 key 回落主色） */
