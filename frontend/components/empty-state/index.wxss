.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  color: var(--color-border, #E5E6EB);
  line-height: 1;
}

.empty-text {
  margin-top: 24rpx;
  color: var(--color-text-3, #86909C);
  font-size: 28rpx;
}

.empty-sub {
  margin-top: 8rpx;
  color: var(--color-text-3, #86909C);
  font-size: 24rpx;
  opacity: 0.8;
}
