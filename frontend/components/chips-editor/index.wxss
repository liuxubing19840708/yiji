.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  position: relative;
  display: flex;
  align-items: center;
  background: #F2F3F5;
  border: 2rpx solid transparent;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  font-size: 26rpx;
  color: var(--color-text-2, #4E5969);
}

.chip.on {
  background: var(--color-primary-light, #FFF3E8);
  border-color: var(--color-primary, #FF7A00);
  color: var(--color-primary, #FF7A00);
  font-weight: 500;
}

.chip-badge {
  margin-left: 10rpx;
  min-width: 30rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: var(--color-primary, #FF7A00);
  color: #ffffff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
  padding: 0 6rpx;
}

.chip-x {
  margin-left: 8rpx;
  color: var(--color-text-3, #86909C);
  font-size: 28rpx;
  padding: 0 6rpx;
}

.chip-add {
  background: var(--color-primary-light, #FFF3E8);
  color: var(--color-primary, #FF7A00);
  font-weight: 600;
}
