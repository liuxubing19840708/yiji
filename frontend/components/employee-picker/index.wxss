/* 员工选择器（规格 §11.3）：颜色/圆角一律走 app.wxss 设计令牌 */
.ep-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.ep-sheet {
  width: 100%;
  background: var(--color-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.ep-head {
  margin-bottom: 20rpx;
}

/* ---- 搜索 ---- */
.ep-search-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.ep-search {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--color-bg);
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
}
.ep-search-icon {
  color: var(--color-text-3);
  margin-right: 10rpx;
}
.ep-search-input {
  flex: 1;
  font-size: 28rpx;
}
.ep-search-clear {
  color: var(--color-text-3);
  padding: 0 8rpx;
}
.ep-search-btn {
  margin-left: 16rpx;
  color: var(--color-primary);
  font-size: 28rpx;
}

/* ---- 角色 Tab ---- */
.ep-tabs {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}
.ep-tab {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--color-bg);
  color: var(--color-text-2);
  font-size: 26rpx;
}
.ep-tab.on {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

/* ---- 3 列姓名网格 ---- */
.ep-grid-wrap {
  max-height: 46vh;
  min-height: 240rpx;
}
.ep-state {
  text-align: center;
  color: var(--color-text-3);
  padding: 60rpx 0;
}
.ep-retry {
  width: 40%;
  margin: 16rpx auto 0;
}
.ep-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20rpx;
  padding-bottom: 8rpx;
}
.ep-cell {
  background: var(--color-bg);
  border: 3rpx solid transparent;
  border-radius: var(--radius);
  padding: 20rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ep-cell.picked {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}
.ep-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--color-card);
  color: var(--color-primary);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ep-cell.picked .ep-avatar {
  color: var(--color-primary);
}
.ep-name {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--color-text);
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ep-cell.picked .ep-name {
  color: var(--color-primary);
  font-weight: 600;
}

/* ---- 橙色确定 ---- */
.ep-confirm {
  margin-top: 24rpx;
}
