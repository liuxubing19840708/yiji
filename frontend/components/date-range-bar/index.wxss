.drb {
  display: flex;
  align-items: center;
  background: var(--color-card, #fff);
  border-radius: 999rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 24rpx;
}

.drb-date {
  color: var(--color-text, #1F2329);
  font-size: 24rpx;
  padding: 6rpx 8rpx;
  white-space: nowrap; /* 日期不许断行（4 个快捷 tab 会把它挤到 2026-10- 换行） */
}

.drb-sep {
  color: var(--color-text-3, #86909C);
  font-size: 24rpx;
  margin: 0 4rpx;
}

.drb-caret {
  color: var(--color-text-3, #86909C);
  font-size: 22rpx;
  margin-right: 16rpx;
}

.drb-tabs {
  display: flex;
  margin-left: auto;
  background: #F2F3F5;
  border-radius: 999rpx;
  padding: 4rpx;
}

.drb-tab {
  font-size: 22rpx;
  color: var(--color-text-2, #4E5969);
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
}

.drb-tab.on {
  background: var(--color-primary, #FF7A00);
  color: #ffffff;
  font-weight: 500;
}
