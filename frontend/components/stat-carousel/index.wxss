.stat-carousel {
  background: linear-gradient(135deg, var(--color-primary, #FF7A00), var(--color-primary-dark, #E86D00));
  border-radius: var(--radius-lg, 24rpx);
  box-shadow: 0 8rpx 24rpx rgba(255, 122, 0, 0.25);
  padding: 8rpx 24rpx 16rpx;
  margin-bottom: 24rpx;
}

.swiper {
  height: 200rpx;
}

.stat-page {
  display: flex;
  flex-direction: column;
}

/* 单行：均分；两行分组时第一行 3 列 */
.stat-row {
  display: flex;
}

.stat {
  flex: 1;
  text-align: center;
  color: #ffffff;
  padding-top: 28rpx;
}

/* 第二行（金额组）：50% 两列，上缘半透明分隔线与第一行分组 */
.stat-row-half .stat {
  flex: 0 0 50%;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
  margin-top: 16rpx;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  white-space: nowrap;
}

.stat-unit {
  font-size: 22rpx;
  font-weight: 400;
  margin-left: 4rpx;
  opacity: 0.9;
}

.stat-title {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

.stat-sub {
  font-size: 20rpx;
  opacity: 0.75;
}

/* 第 2 页：简易区间选择 */
.calendar-page {
  color: #ffffff;
  padding: 12rpx 8rpx;
}

.cal-title {
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 8rpx;
}

.cal-field {
  display: flex;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  margin-bottom: 10rpx;
}

.cal-label {
  opacity: 0.85;
}

.cal-ok {
  text-align: center;
  background: #ffffff;
  color: var(--color-primary, #FF7A00);
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  padding: 10rpx 0;
}

.dots {
  display: flex;
  justify-content: center;
  margin-top: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
  margin: 0 6rpx;
}

.dot.on {
  background: #ffffff;
  width: 28rpx;
  border-radius: 999rpx;
}
