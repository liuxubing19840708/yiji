.tabbar {
  display: flex;
  align-items: flex-end;
  background: #ffffff;
  border-top: 2rpx solid #E5E6EB;
  padding-bottom: env(safe-area-inset-bottom);
  height: 110rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 110rpx;
  position: relative;
  color: var(--color-text-3, #86909C);
  font-size: 20rpx;
}

.tab-item.active {
  color: var(--color-primary, #FF7A00);
}

/* 简约 CSS 图标：小方块 + 圆点区分（Wave 1 可替换为 iconfont/图片） */
.tab-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 4rpx solid currentColor;
  margin-bottom: 6rpx;
  box-sizing: border-box;
  opacity: 0.9;
}
.tab-icon-scan { transform: rotate(45deg); }
.tab-icon-notifications { border-radius: 10rpx 10rpx 10rpx 0; }
.tab-icon-profile { border-radius: 50% 50% 0 0; }

.tab-dot {
  position: absolute;
  top: 10rpx;
  right: 24rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: var(--color-danger, #F53F3F);
  color: #ffffff;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
}

/* 中央 AI问报 FAB：凸起橙色圆钮 */
.fab-wrap {
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  top: -40rpx;
}

.fab {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--color-primary, #FF7A00);
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 8rpx solid #ffffff;
  box-sizing: content-box;
}

/* FAB 内 AI 字标（白字加粗，居中） */
.fab-ai {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
  line-height: 1;
}

.fab-text {
  font-size: 20rpx;
  color: var(--color-primary, #FF7A00);
  margin-top: 4rpx;
  font-weight: 600;
}
