<!-- 自定义 tabBar：4 个常规项 + 中央凸起橙色 AI问报 FAB（规格 §21.2 变体，2026-10-26） -->
<view class="tabbar">
  <view
    wx:for="{{leftItems}}"
    wx:key="key"
    class="tab-item {{selected === item.index ? 'active' : ''}}"
    data-path="{{item.path}}"
    data-index="{{item.index}}"
    bindtap="onTap"
  >
    <view class="tab-icon tab-icon-{{item.key}}"></view>
    <view class="tab-text">{{item.text}}</view>
  </view>

  <!-- 中央 AI问报 FAB -->
  <view class="fab-wrap">
    <view class="fab" bindtap="onFab">
      <view class="fab-ai">AI</view>
    </view>
    <view class="fab-text">AI问报</view>
  </view>

  <view
    wx:for="{{rightItems}}"
    wx:key="key"
    class="tab-item {{selected === item.index ? 'active' : ''}}"
    data-path="{{item.path}}"
    data-index="{{item.index}}"
    bindtap="onTap"
  >
    <view class="tab-icon tab-icon-{{item.key}}"></view>
    <view class="tab-text">{{item.text}}</view>
    <view wx:if="{{item.key === 'notifications' && unread > 0}}" class="tab-dot">{{unread > 99 ? '99+' : unread}}</view>
  </view>
</view>
